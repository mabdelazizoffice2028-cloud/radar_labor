/// Smart daily site attendance screen with dedicated back button navigation.
final class SiteAttendanceScreen extends ConsumerStatefulWidget {
  const SiteAttendanceScreen({
    required this.controller,
    required this.arabic,
    this.teamSetupStore,
    this.actor,
    this.scope,
    super.key,
  });

  final OperationsController controller;
  final bool arabic;
  final TeamSetupStore? teamSetupStore;
  final ActorContext? actor;
  final ScopeSnapshot? scope;

  @override
  ConsumerState<SiteAttendanceScreen> createState() =>
      _SiteAttendanceScreenState();
}

final class _SiteAttendanceScreenState
    extends ConsumerState<SiteAttendanceScreen> {
  Future<void> _openEditTeam(EntityOption team) async {
    final store = widget.teamSetupStore;
    final actor = widget.actor;
    final scope = widget.scope;
    if (store == null || actor == null || scope == null) return;
    final updated = await Navigator.push<bool>(
      context,
      MaterialPageRoute(
        builder: (_) => TeamEditScreen(
          store: store,
          actor: actor,
          scope: scope,
          team: team,
          arabic: widget.arabic,
        ),
      ),
    );
    if (updated == true && mounted) {
      await ref.read(siteAttendanceNotifierProvider.notifier).reload();
    }
  }

  Future<void> _handleSave() async {
    final ar = widget.arabic;
    final notifier = ref.read(siteAttendanceNotifierProvider.notifier);
    final state = ref.read(siteAttendanceNotifierProvider);
    final prepared = await notifier.prepareSave();
    if (prepared == null || !mounted) return;

    final diffOk = await AttendanceDiffDialog.show(
      context: context,
      team: prepared.team,
      date: prepared.date,
      diff: prepared.diff,
      arabic: ar,
    );
    if (!diffOk || !mounted) return;

    var resolutions = <String, ConflictResolutionChoice>{};
    if (prepared.conflicts.isNotEmpty) {
      final res = await AttendanceConflictDialog.show(
        context: context,
        conflicts: prepared.conflicts,
        currentTeamName: prepared.team.displayName(arabic: ar),
        arabic: ar,
        currentDate: prepared.date,
      );
      if (res == null || !mounted) return;
      resolutions = res;
    }

    final presentWorkers = state.rows
        .where((r) => r.isPresent)
        .map((r) => r.worker)
        .toList();
    final action = await OperationConfirmSyncDialog.show(
      context: context,
      title: OperationsStrings.confirmSiteAttendanceTitle(ar),
      entityName: prepared.team.displayName(arabic: ar),
      date: prepared.date,
      countSummaryText: OperationsStrings.presentCountLabel(
        ar,
        state.presentCount,
      ),
      selectedWorkers: presentWorkers,
      emptySelectionText: OperationsStrings.zeroWorkersConfirmation(ar),
      arabic: ar,
    );
    if (action == null || !mounted) return;

    final result = await notifier.confirmSave(
      prepared: prepared,
      resolutions: resolutions,
    );
    if (result == null || !mounted) return;

    if (action == ConfirmSaveAction.saveAndSync) {
      await performOperationSync(
        ref: ref,
        context: context,
        actor: widget.actor,
        scope: widget.scope,
        arabic: ar,
      );
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(OperationsStrings.teamSavedLocally(ar)),
          duration: OperationsConstants.undoWindow,
          action: SnackBarAction(
            label: OperationsStrings.undoAction(ar),
            onPressed: () => unawaited(notifier.undoLastSave()),
          ),
        ),
      );
    }

    if (!mounted) return;
    await showOperationWhatsappDialog(
      context: context,
      messageText: result.summary.messageText,
      arabic: ar,
    );
    if (mounted && Navigator.of(context).canPop()) {
      Navigator.of(context).pop();
    }
  }

  @override
  Widget build(BuildContext context) {
    final ar = widget.arabic;
    final notifier = ref.read(siteAttendanceNotifierProvider.notifier)
      ..setOverrideContext(actor: widget.actor, scope: widget.scope);
    final state = ref.watch(siteAttendanceNotifierProvider);

    final content = StreamBuilder<List<EntityOption>>(
      stream: widget.controller.watchTeams(),
      builder: (context, teamSnapshot) {
        if (!teamSnapshot.hasData) {
          return const Center(child: CircularProgressIndicator());
        }
        final teams = teamSnapshot.data ?? const <EntityOption>[];
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (mounted) unawaited(notifier.ensureInitialTeam(teams));
        });

        final selected = state.selectedTeam ?? teams.firstOrNull;
        final canEdit =
            widget.teamSetupStore != null &&
            (widget.actor?.capabilities.canEditOwnTeamMembers ?? false) &&
            selected != null;

        return Column(
          children: [
            SiteAttendanceHeader(
              teams: teams,
              selected: selected,
              state: state,
              arabic: ar,
              canEditTeam: canEdit,
              onTeamChanged: (id) => unawaited(
                notifier.selectTeam(teams.where((t) => t.id == id).firstOrNull),
              ),
              onDateSelected: (d) => unawaited(notifier.selectDate(d)),
              onEditTeam: selected == null
                  ? null
                  : () => _openEditTeam(selected),
              onSelectAll: notifier.selectAll,
              onAddGuest: () => CrossTeamSearchSheet.show(
                context: context,
                arabic: ar,
                onSearch: notifier.searchGuests,
                onWorkerSelected: notifier.addGuestWorker,
              ),
            ),
            if (state.errorMessage != null)
              Padding(
                padding: const EdgeInsets.symmetric(
                  horizontal: AppTokens.space16,
                ),
                child: Text(
                  state.errorMessage!,
                  style: TextStyle(color: Theme.of(context).colorScheme.error),
                ),
              ),
            if (selected != null && state.rows.isNotEmpty)
              Padding(
                padding: const EdgeInsets.symmetric(
                  horizontal: AppTokens.space16,
                  vertical: AppTokens.space4,
                ),
                child: TextField(
                  key: const ValueKey('site_worker_search_field'),
                  decoration: InputDecoration(
                    hintText: OperationsStrings.searchWorkersHint(ar),
                    prefixIcon: const Icon(Icons.search, size: 20),
                    isDense: true,
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(AppTokens.radius12),
                    ),
                    suffixIcon: state.searchQuery.isNotEmpty
                        ? IconButton(
                            icon: const Icon(Icons.clear, size: 18),
                            onPressed: () => notifier.setSearchQuery(''),
                          )
                        : null,
                  ),
                  onChanged: notifier.setSearchQuery,
                ),
              ),
            Expanded(
              child: SiteWorkerListView(
                state: state,
                selected: selected,
                arabic: ar,
                onToggle: notifier.toggleWorker,
                onRemoveGuest: notifier.removeGuestWorker,
              ),
            ),
            AttendanceCounterBar(
              presentCount: state.presentCount,
              arabic: ar,
              enabled: selected != null && !state.isLoading,
              isSaving: state.isSaving,
              onSave: _handleSave,
            ),
          ],
        );
      },
    );

    if (Navigator.of(context).canPop()) {
      return Scaffold(
        appBar: AppBar(
          title: Text(OperationsStrings.startSiteAttendanceAction(ar)),
        ),
        body: content,
      );
    }
    return content;
  }
}
</file>

<file path="test/core/database/encrypted_database_test.dart">
import 'dart:convert';
import 'dart:io';

import 'package:drift/native.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:radar_labor/core/constants/app_constants.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:radar_labor/core/database/database_encryption.dart';
import 'package:radar_labor/core/database/database_open_exception.dart';
import 'package:radar_labor/core/database/database_opener.dart';
import 'package:sqlite3/sqlite3.dart';

const _keyA =
    'a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90';
const _keyB =
    '0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0';
const _plaintextProbe = 'plaintext_probe_value';

AppDatabase _open(File file, String key) => AppDatabase(
  NativeDatabase(file, setup: (raw) => applyEncryption(raw, key)),
);

Future<AppDatabase> _openInBackground(File file, String key) =>
    openEncryptedDatabase(file, key);

Future<void> _insert(AppDatabase db, String key, String value) {
  return db
      .into(db.settings)
      .insert(SettingsCompanion.insert(key: key, value: value));
}

void main() {
  late Directory directory;
  late File file;

  setUp(() {
    directory = Directory.systemTemp.createTempSync('radar_labor_db_');
    file = File('${directory.path}/${DatabaseConstants.fileName}');
  });

  tearDown(() => directory.deleteSync(recursive: true));

  test('cipherPragma_isNotEmpty_whenSqlite3mcIsActive', () {
    final raw = sqlite3.openInMemory();
    addTearDown(raw.close);
    expect(raw.select('PRAGMA cipher'), isNotEmpty);
  });

  test('encryption_rejectsKeysWithWrongLengthOrCharacters', () {
    final raw = sqlite3.openInMemory();
    addTearDown(raw.close);

    final nonHexKey = List<String>.filled(
      DatabaseConstants.keyByteLength * 2,
      'g',
    ).join();
    final longKey = List<String>.filled(
      DatabaseConstants.keyByteLength * 2 + 1,
      'a',
    ).join();

    expect(() => applyEncryption(raw, nonHexKey), throwsArgumentError);
    expect(() => applyEncryption(raw, longKey), throwsArgumentError);
  });

  test('schemaVersion_isThree_onFreshDatabase', () async {
    final db = _open(file, _keyA);
    addTearDown(db.close);
    final row = await db.customSelect('PRAGMA user_version').getSingle();
    expect(row.read<int>('user_version'), DatabaseConstants.schemaVersion);
  });

  test('backgroundOpener_encryptsAndMigratesFreshDatabase', () async {
    final db = await _openInBackground(file, _keyA);
    addTearDown(db.close);

    final cipherRows = await db.customSelect('PRAGMA cipher').get();
    final version = await db.customSelect('PRAGMA user_version').getSingle();
    final settingsTable = await db
        .customSelect(
          "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'settings'",
        )
        .get();
    final eventTable = await db
        .customSelect(
          "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'events'",
        )
        .get();

    expect(cipherRows, isNotEmpty);
    expect(version.read<int>('user_version'), DatabaseConstants.schemaVersion);
    expect(settingsTable, hasLength(1));
    expect(eventTable, hasLength(1));
  });

  test('v1Database_migratesToV3AndPreservesSettings', () async {
    final raw = sqlite3.open(file.path);
    applyEncryption(raw, _keyA);
    raw.execute(
      'CREATE TABLE settings (key TEXT NOT NULL PRIMARY KEY, value TEXT NOT NULL)',
    );
    raw.execute("INSERT INTO settings (key, value) VALUES ('language', 'ar')");
    raw.execute('PRAGMA user_version = 1');
    raw.close();

    final db = await _openInBackground(file, _keyA);
    addTearDown(db.close);
    final version = await db.customSelect('PRAGMA user_version').getSingle();
    final setting = await db.select(db.settings).getSingle();
    final eventsTable = await db
        .customSelect(
          "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'events'",
        )
        .get();

    expect(version.read<int>('user_version'), DatabaseConstants.schemaVersion);
    expect(setting.value, 'ar');
    expect(eventsTable, hasLength(1));
  });

  test('v2Database_addsSupplierWithoutChangingExistingEmployees', () async {
    final raw = sqlite3.open(file.path);
    applyEncryption(raw, _keyA);
    raw.execute('''CREATE TABLE employees (
      employee_uid TEXT NOT NULL PRIMARY KEY,
      employee_code TEXT NOT NULL,
      full_name_ar TEXT NOT NULL,
      full_name_en TEXT NULL,
      category TEXT NOT NULL,
      current_team_id TEXT NULL,
      housing_id TEXT NULL,
      is_active INTEGER NOT NULL DEFAULT 1,
      row_version INTEGER NOT NULL DEFAULT 1
    )''');
    raw.execute(
      'CREATE TABLE settings (key TEXT NOT NULL PRIMARY KEY, value TEXT NOT NULL)',
    );
    raw.execute(
      "INSERT INTO employees (employee_uid, employee_code, full_name_ar, category) VALUES ('e-1', '1', 'Test', 'Worker')",
    );
    raw.execute('PRAGMA user_version = 2');
    raw.close();

    final db = await _openInBackground(file, _keyA);
    addTearDown(db.close);
    final employee = await db.select(db.employees).getSingle();
    expect(employee.employeeUid, 'e-1');
    expect(employee.supplier, isNull);
    expect(
      (await db.customSelect('PRAGMA user_version').getSingle()).read<int>(
        'user_version',
      ),
      DatabaseConstants.schemaVersion,
    );
  });

  test('storedData_isNotPlaintextOnDisk_andSurvivesReopen', () async {
    var db = _open(file, _keyA);
    await _insert(db, 'probe', _plaintextProbe);
    await db.close();

    expect(
      latin1.decode(file.readAsBytesSync()),
      isNot(contains(_plaintextProbe)),
    );

    db = _open(file, _keyA);
    addTearDown(db.close);
    final rows = await db.select(db.settings).get();
    expect(rows.single.value, _plaintextProbe);
  });

  test('openWithWrongKey_throwsOpenException', () async {
    final db = _open(file, _keyA);
    await _insert(db, 'k', 'v');
    await db.close();

    final wrong = _open(file, _keyB);
    addTearDown(wrong.close);
    await expectLater(
      wrong.select(wrong.settings).get(),
      throwsA(isA<DatabaseOpenException>()),
    );
  });

  test('backgroundOpener_preservesTypedFailureForWrongKey', () async {
    final db = _open(file, _keyA);
    await _insert(db, 'k', 'v');
    await db.close();

    await expectLater(
      _openInBackground(file, _keyB),
      throwsA(isA<DatabaseOpenException>()),
    );
  });
}
