import 'package:radar_labor/core/auth/role_capabilities.dart';
import 'package:radar_labor/core/l10n/attendance_message_strings.dart';
import 'package:radar_labor/core/time/business_date.dart';
import 'package:radar_labor/core/time/clock.dart';
import 'package:radar_labor/features/operations/domain/attendance_summary.dart';
import 'package:radar_labor/features/operations/domain/operation_failure.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';
import 'package:radar_labor/features/operations/domain/operations_store.dart';

final class PreparedHousingCheck {
  const PreparedHousingCheck({
    required this.housing,
    required this.date,
    required this.summary,
  });

  final EntityOption housing;
  final String date;
  final AttendanceSummary summary;
}

final class PreparedSiteAttendance {
  const PreparedSiteAttendance({
    required this.team,
    required this.date,
    required this.summary,
  });

  final EntityOption team;
  final String date;
  final AttendanceSummary summary;
}

/// Coordinates daily operation rules while screens handle only presentation (BC-3).
final class OperationsController {
  const OperationsController({
    required this.store,
    required this.clock,
    required this.actorUserId,
    required this.capabilities,
    this.allowedHousingIds = const [],
    this.allowedTeamIds = const [],
  });

  final OperationsStore store;
  final Clock clock;
  final String actorUserId;
  final RoleCapabilities capabilities;
  final List<String> allowedHousingIds;
  final List<String> allowedTeamIds;

  bool get canHousing => capabilities.canRecordHousing;
  bool get canSite => capabilities.canRecordSite;
  bool _allowsHousing(String id) =>
      canHousing && allowedHousingIds.contains(id);
  bool _allowsTeam(String id) => canSite && allowedTeamIds.contains(id);

  Stream<List<EntityOption>> watchHousings() => store.watchHousings().map(
    (items) =>
        items.where((item) => _allowsHousing(item.id)).toList(growable: false),
  );

  Stream<List<EntityOption>> watchTeams() => store.watchTeams().map(
    (items) =>
        items.where((item) => _allowsTeam(item.id)).toList(growable: false),
  );

  Stream<List<WorkerOption>> watchHousingWorkers(String housingId) =>
      _allowsHousing(housingId)
      ? store.watchHousingWorkers(housingId)
      : const Stream.empty();

  Stream<List<WorkerOption>> watchTeamWorkers(String teamId) =>
      _allowsTeam(teamId)
      ? store.watchTeamWorkers(teamId)
      : const Stream.empty();

  Future<PreparedHousingCheck> prepareHousingCheck({
    required EntityOption housing,
    required Set<String> absentIds,
    required bool arabic,
  }) async {
    await _guard(canHousing && _allowsHousing(housing.id));
    final workers = await watchHousingWorkers(housing.id).first;
    final date = businessDateFor(clock.nowUtc());
    return PreparedHousingCheck(
      housing: housing,
      date: date,
      summary: AttendanceSummary.housingCheck(
        housing: housing,
        date: date,
        workers: workers,
        absentIds: absentIds,
        arabic: arabic,
        strings: AttendanceMessageStrings.fromLanguage(arabic: arabic),
      ),
    );
  }

  Future<HousingCheckUndo> saveHousingCheck(PreparedHousingCheck check) =>
      _guard(canHousing && _allowsHousing(check.housing.id)).then(
        (_) => store.saveHousingCheck(
          date: check.date,
          housing: check.housing,
          absentIds: check.summary.workerIds,
          actorUserId: actorUserId,
        ),
      );

  Future<void> undoHousingCheck(HousingCheckUndo undo) =>
      _guard(canHousing && _allowsHousing(undo.housingId))
          .then((_) => store.undoHousingCheck(undo, actorUserId: actorUserId));

  Future<PreparedSiteAttendance> prepareSiteAttendance({
    required EntityOption team,
    required Set<String> presentIds,
    required bool arabic,
  }) async {
    await _guard(canSite && _allowsTeam(team.id));
    final workers = await watchTeamWorkers(team.id).first;
    final date = businessDateFor(clock.nowUtc());
    return PreparedSiteAttendance(
      team: team,
      date: date,
      summary: AttendanceSummary.siteAttendance(
        team: team,
        date: date,
        workers: workers,
        presentIds: presentIds,
        arabic: arabic,
        strings: AttendanceMessageStrings.fromLanguage(arabic: arabic),
      ),
    );
  }

  Future<SiteAttendanceUndo> saveSiteAttendance(
    PreparedSiteAttendance attendance,
  ) => _guard(canSite && _allowsTeam(attendance.team.id)).then(
    (_) => store.saveSiteAttendance(
      date: attendance.date,
      team: attendance.team,
      presentIds: attendance.summary.workerIds,
      actorUserId: actorUserId,
    ),
  );

  Future<void> undoSiteAttendance(SiteAttendanceUndo undo) => _guard(
    canSite && _allowsTeam(undo.teamId),
  ).then((_) => store.undoSiteAttendance(undo, actorUserId: actorUserId));

  Future<void> _guard(bool allowed) async {
    if (!allowed) throw const OperationException(PermissionDenied());
  }
}
</file>

<file path="lib/features/operations/presentation/state/site_attendance_notifier.dart">
import 'dart:async';

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:radar_labor/app/app_providers.dart';
import 'package:radar_labor/core/auth/scope_snapshot.dart';
import 'package:radar_labor/core/constants/operations_constants.dart';
import 'package:radar_labor/core/l10n/name_collation.dart';
import 'package:radar_labor/features/operations/domain/attendance_summary.dart';
import 'package:radar_labor/features/operations/domain/conflict_detector.dart';
import 'package:radar_labor/features/operations/domain/ledger_undo_plan.dart';
import 'package:radar_labor/features/operations/domain/operation_failure.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';
import 'package:radar_labor/features/operations/domain/site_attendance_store.dart';
import 'package:radar_labor/features/operations/presentation/state/site_attendance_state.dart';

export 'package:radar_labor/features/operations/presentation/state/site_attendance_state.dart'
    show scopedSiteTeamsProvider;

/// Controller for smart daily site attendance (PRD §8, §9, §10).
final class SiteAttendanceNotifier extends Notifier<SiteAttendanceState> {
  Timer? _draftTimer;
  ActorContext? _overrideActor;
  ScopeSnapshot? _overrideScope;

  @override
  SiteAttendanceState build() {
    ref.onDispose(() => _draftTimer?.cancel());
    final today = _store.currentBusinessDate();
    return SiteAttendanceState(selectedDate: today, todayDate: today);
  }

  SiteAttendanceStore get _store => ref.read(siteAttendanceStoreProvider);
  bool get _isArabic => ref.read(appLocaleProvider) == 'ar';

  void setOverrideContext({ActorContext? actor, ScopeSnapshot? scope}) =>
      (_overrideActor = actor, _overrideScope = scope);

  ({ActorContext actor, ScopeSnapshot scope})? _actorAndScope() {
    if (_overrideActor != null && _overrideScope != null) {
      return (actor: _overrideActor!, scope: _overrideScope!);
    }
    final s = ref.read(currentSessionProvider);
    if (s == null) return null;
    final scope =
        ref.read(userScopesProvider(s.id)).value ??
        ScopeSnapshot(
          teamIds: s.teamIds.toSet(),
          housingIds: s.housingIds.toSet(),
        );
    return (actor: ActorContext(userId: s.id, role: s.role), scope: scope);
  }

  Future<void> ensureInitialTeam(List<EntityOption> teams) async {
    if (teams.isEmpty) {
      if (state.selectedTeam != null) {
        state = state.copyWith(clearSelectedTeam: true, rows: const []);
      }
      return;
    }
    final cur = state.selectedTeam;
    if (cur != null && teams.any((t) => t.id == cur.id)) {
      if (state.rows.isEmpty && !state.isLoading) {
        await _load(team: cur, date: state.selectedDate);
      }
      return;
    }
    await selectTeam(teams.first);
  }

  Future<void> selectTeam(EntityOption? team) async {
    await flushDraft();
    if (team != null) return _load(team: team, date: state.selectedDate);
    state = state.copyWith(
      clearSelectedTeam: true,
      rows: const [],
      clearError: true,
    );
  }

  Future<void> selectDate(String date) async {
    await flushDraft();
    final team = state.selectedTeam;
    if (team != null) return _load(team: team, date: date);
    final today = _store.currentBusinessDate();
    state = state.copyWith(
      selectedDate: date,
      todayDate: today,
      isPastDate: date.compareTo(today) < 0,
    );
  }

  Future<void> openTeamAndDate({
    required EntityOption team,
    required String date,
  }) => flushDraft().then((_) => _load(team: team, date: date));

  Future<void> reload() async => state.selectedTeam == null
      ? null
      : _load(team: state.selectedTeam!, date: state.selectedDate);

  Future<void> _load({required EntityOption team, required String date}) async {
    final ctx = _actorAndScope();
    if (ctx == null) return;
    final today = _store.currentBusinessDate();
    state = state.copyWith(
      selectedTeam: team,
      selectedDate: date,
      todayDate: today,
      isPastDate: date.compareTo(today) < 0,
      isLoading: true,
      clearError: true,
    );
    try {
      final d = await _store.loadDay(
        actor: ctx.actor,
        scope: ctx.scope,
        team: team,
        date: date,
        arabic: _isArabic,
      );
      state = state.withLoadedDay(d, today);
    } on OperationException catch (error) {
      _setFailure(error);
    }
  }

  void setSearchQuery(String query) =>
      state = state.copyWith(searchQuery: query);

  void toggleWorker(String workerId) => _updateRows([
    for (final row in state.rows)
      if (row.worker.id == workerId && !row.isLocked)
        row.copyWith(isPresent: !row.isPresent)
      else
        row,
  ]);

  void selectAll(bool present) {
    final visibleIds = state.filteredRows.map((r) => r.worker.id).toSet();
    _updateRows([
      for (final row in state.rows)
        if (!row.isLocked && visibleIds.contains(row.worker.id))
          row.copyWith(isPresent: present)
        else
          row,
    ]);
  }

  void addGuestWorker(CrossTeamWorkerOption guest) {
    if (state.existingWorkerIds.contains(guest.worker.id)) return;
    final ar = _isArabic;
    final updated = [
      ...state.rows,
      AttendanceRow(
        worker: guest.worker,
        isPresent: true,
        origin: WorkerRowOrigin.guest,
        originTeamNameAr: guest.teamNameAr,
        originTeamNameEn: guest.teamNameEn,
      ),
    ]..sort((a, b) => _cmp(a.worker, b.worker, ar));
    _updateRows(updated);
  }

  int _cmp(WorkerOption a, WorkerOption b, bool ar) =>
      NameCollation.compareWorkers(
        nameA: a.displayName(arabic: ar),
        codeA: a.code,
        idA: a.id,
        nameB: b.displayName(arabic: ar),
        codeB: b.code,
        idB: b.id,
      );

  void removeGuestWorker(String workerId) => _updateRows([
    for (final row in state.rows)
      if (!(row.isGuest && row.worker.id == workerId)) row,
  ]);

  void _updateRows(List<AttendanceRow> rows) {
    state = state.copyWith(
      rows: List.unmodifiable(rows),
      skippedDraftCount: 0,
      clearError: true,
    );
    _draftTimer?.cancel();
    _draftTimer = Timer(
      OperationsConstants.draftDebounce,
      () => unawaited(flushDraft()),
    );
  }

  Future<List<CrossTeamWorkerOption>> searchGuests(String query) =>
      _store.searchCrossTeamWorkers(
        query: query,
        excludeWorkerIds: state.existingWorkerIds,
        arabic: _isArabic,
      );

  Future<PreparedSiteSave?> prepareSave() async {
    await flushDraft();
    final ctx = _actorAndScope();
    final team = state.selectedTeam;
    if (ctx == null || team == null) return null;
    try {
      return await _store.prepareSave(
        actor: ctx.actor,
        scope: ctx.scope,
        team: team,
        date: state.selectedDate,
        rows: state.rows,
        baseline: state.baseline,
        arabic: _isArabic,
      );
    } on OperationException catch (e) {
      _setFailure(e);
      return null;
    }
  }

  Future<({LedgerUndoPlan undoPlan, AttendanceSummary summary})?> confirmSave({
    required PreparedSiteSave prepared,
    required Map<String, ConflictResolutionChoice> resolutions,
  }) async {
    _draftTimer?.cancel();
    final ctx = _actorAndScope();
    if (ctx == null) return null;
    state = state.copyWith(isSaving: true, clearError: true);
    try {
      final res = await _store.save(
        actor: ctx.actor,
        scope: ctx.scope,
        prepared: prepared,
        resolutions: resolutions,
        arabic: _isArabic,
      );
      await _load(team: prepared.team, date: prepared.date);
      state = state.copyWith(
        isSaving: false,
        lastUndoPlan: res.undoPlan,
        lastSummary: res.summary,
      );
      return res;
    } on OperationException catch (e) {
      _setFailure(e);
      return null;
    }
  }

  Future<bool> undoLastSave() async {
    final ctx = _actorAndScope();
    final team = state.selectedTeam;
    final plan = state.lastUndoPlan;
    if (ctx == null || team == null || plan == null) return false;
    try {
      await _store.undo(
        actor: ctx.actor,
        scope: ctx.scope,
        teamId: team.id,
        plan: plan,
      );
      state = state.copyWith(clearUndoPlan: true, clearSummary: true);
      await _load(team: team, date: state.selectedDate);
      return true;
    } on OperationException catch (e) {
      _setFailure(e);
      return false;
    }
  }

  Future<void> flushDraft() async {
    final pending = _draftTimer;
    if (pending == null || !pending.isActive) return;
    pending.cancel();
    final team = state.selectedTeam;
    if (team == null) return;
    final drafts = ref.read(attendanceDraftStoreProvider);
    await drafts.writeDraft(
      teamId: team.id,
      date: state.selectedDate,
      workerIds: state.selectedActiveWorkerIds,
    );
  }

  void _setFailure(OperationException e) => state = state.copyWith(
    isLoading: false,
    isSaving: false,
    errorMessage: OperationFailureMessage.of(e.failure, _isArabic),
  );
}

final siteAttendanceNotifierProvider =
    NotifierProvider<SiteAttendanceNotifier, SiteAttendanceState>(
      SiteAttendanceNotifier.new,
    );
</file>

<file path="lib/features/operations/presentation/state/site_attendance_state.dart">
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:radar_labor/app/app_providers.dart';
import 'package:radar_labor/features/operations/domain/attendance_diff.dart';
import 'package:radar_labor/features/operations/domain/attendance_summary.dart';
import 'package:radar_labor/features/operations/domain/ledger_undo_plan.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';
import 'package:radar_labor/features/operations/domain/site_attendance_store.dart';

/// Stream of active teams allowed for the current session user.
final scopedSiteTeamsProvider = StreamProvider<List<EntityOption>>((ref) {
  final session = ref.watch(currentSessionProvider);
  if (session == null) return Stream.value(const <EntityOption>[]);
  final scopesAsync = ref.watch(userScopesProvider(session.id));
  final allowedIds = scopesAsync.value?.teamIds ?? session.teamIds.toSet();
  return ref.watch(siteAttendanceStoreProvider).watchScopedTeams(allowedIds);
});

/// Immutable UI state for smart daily site attendance (PRD §8, §9, §10).
final class SiteAttendanceState {
  const SiteAttendanceState({
    required this.selectedDate,
    required this.todayDate,
    this.selectedTeam,
    this.isPastDate = false,
    this.isLoading = false,
    this.isSaving = false,
    this.searchQuery = '',
    this.rows = const <AttendanceRow>[],
    this.baseline = const AttendanceBaseline(kind: BaselineKind.none),
    this.initialSource = AttendanceInitialSource.empty,
    this.initialSourceDate,
    this.skippedDraftCount = 0,
    this.lastUndoPlan,
    this.lastSummary,
    this.errorMessage,
  });

  final EntityOption? selectedTeam;
  final String selectedDate;
  final String todayDate;
  final bool isPastDate;
  final bool isLoading;
  final bool isSaving;
  final String searchQuery;
  final List<AttendanceRow> rows;
  final AttendanceBaseline baseline;
  final AttendanceInitialSource initialSource;
  final String? initialSourceDate;
  final int skippedDraftCount;
  final LedgerUndoPlan? lastUndoPlan;
  final AttendanceSummary? lastSummary;
  final String? errorMessage;

  int get presentCount => rows.where((row) => row.isPresent).length;

  Set<String> get existingWorkerIds => {for (final row in rows) row.worker.id};

  Set<String> get selectedActiveWorkerIds => {
    for (final row in rows)
      if (!row.isLocked && row.isPresent) row.worker.id,
  };

  Set<String> get guestWorkerIds => {
    for (final row in rows)
      if (row.isGuest) row.worker.id,
  };

  List<AttendanceRow> get filteredRows {
    if (searchQuery.trim().isEmpty) return rows;
    final q = searchQuery.trim().toLowerCase();
    return rows
        .where((row) {
          final nameAr = row.worker.nameAr.toLowerCase();
          final nameEn = (row.worker.nameEn ?? '').toLowerCase();
          final code = row.worker.code.toLowerCase();
          return nameAr.contains(q) || nameEn.contains(q) || code.contains(q);
        })
        .toList(growable: false);
  }

  SiteAttendanceState withLoadedDay(LoadedSiteAttendanceDay d, String today) =>
      copyWith(
        selectedTeam: d.team,
        selectedDate: d.date,
        todayDate: today,
        isPastDate: d.isPastDate,
        isLoading: false,
        rows: d.rows,
        baseline: d.baseline,
        initialSource: d.initialSource,
        initialSourceDate: d.initialSourceDate,
        clearInitialSourceDate: d.initialSourceDate == null,
        skippedDraftCount: d.skippedDraftCount,
        clearError: true,
      );

  SiteAttendanceState copyWith({
    EntityOption? selectedTeam,
    bool clearSelectedTeam = false,
    String? selectedDate,
    String? todayDate,
    bool? isPastDate,
    bool? isLoading,
    bool? isSaving,
    String? searchQuery,
    List<AttendanceRow>? rows,
    AttendanceBaseline? baseline,
    AttendanceInitialSource? initialSource,
    String? initialSourceDate,
    bool clearInitialSourceDate = false,
    int? skippedDraftCount,
    LedgerUndoPlan? lastUndoPlan,
    bool clearUndoPlan = false,
    AttendanceSummary? lastSummary,
    bool clearSummary = false,
    String? errorMessage,
    bool clearError = false,
  }) => SiteAttendanceState(
    selectedTeam: clearSelectedTeam
        ? null
        : (selectedTeam ?? this.selectedTeam),
    selectedDate: selectedDate ?? this.selectedDate,
    todayDate: todayDate ?? this.todayDate,
    isPastDate: isPastDate ?? this.isPastDate,
    isLoading: isLoading ?? this.isLoading,
    isSaving: isSaving ?? this.isSaving,
    searchQuery: searchQuery ?? this.searchQuery,
    rows: rows ?? this.rows,
    baseline: baseline ?? this.baseline,
    initialSource: initialSource ?? this.initialSource,
    initialSourceDate: clearInitialSourceDate
        ? null
        : (initialSourceDate ?? this.initialSourceDate),
    skippedDraftCount: skippedDraftCount ?? this.skippedDraftCount,
    lastUndoPlan: clearUndoPlan ? null : (lastUndoPlan ?? this.lastUndoPlan),
    lastSummary: clearSummary ? null : (lastSummary ?? this.lastSummary),
    errorMessage: clearError ? null : (errorMessage ?? this.errorMessage),
  );
}
