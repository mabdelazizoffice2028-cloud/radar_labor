<file path="lib/app/accounts/account_form_dialog.dart">
import 'package:material_ui/material_ui.dart';
import 'package:radar_labor/app/accounts/accounts_admin_controller.dart';
import 'package:radar_labor/core/auth/auth_role.dart';
import 'package:radar_labor/core/auth/local_account.dart';
import 'package:radar_labor/core/constants/app_constants.dart';
import 'package:radar_labor/core/l10n/admin_strings.dart';
import 'package:radar_labor/core/l10n/app_strings.dart';
import 'package:radar_labor/core/ui/app_tokens.dart';

/// Selectable scope option: `(id, label)`.
typedef ScopeOption = (String, String);

/// Add/edit dialog for a sign-in name: person, display name, role and scope.
final class AccountFormDialog extends StatefulWidget {
  const AccountFormDialog({
    required this.arabic,
    required this.employees,
    required this.teams,
    required this.housings,
    this.initial,
    super.key,
  });

  final bool arabic;

  /// `(employeeUid, name)` choices; only used when adding a new account.
  final List<ScopeOption> employees;
  final List<ScopeOption> teams;
  final List<ScopeOption> housings;
  final LocalAccount? initial;

  static Future<AccountFormResult?> show(
    BuildContext context,
    AccountFormDialog dialog,
  ) => showDialog<AccountFormResult>(context: context, builder: (_) => dialog);

  @override
  State<AccountFormDialog> createState() => _AccountFormDialogState();
}

final class _AccountFormDialogState extends State<AccountFormDialog> {
  late final _name = TextEditingController(
    text: widget.initial?.displayName ?? widget.employees.firstOrNull?.$2,
  );
  late String? _employeeUid = widget.employees.firstOrNull?.$1;
  late AuthRole _role = widget.initial?.role ?? AuthRole.siteSupervisor;
  late final Set<String> _teams = {...?widget.initial?.teamIds};
  late final Set<String> _housings = {...?widget.initial?.housingIds};
  String? _error;

  bool get _ar => widget.arabic;
  bool get _adding => widget.initial == null;

  @override
  void dispose() {
    _name.dispose();
    super.dispose();
  }

  void _submit() {
    final name = _name.text.trim();
    if (name.isEmpty) {
      setState(() => _error = AdminStrings.nameRequired(_ar));
      return;
    }
    final effectiveHousings = _role == AuthRole.housingSupervisor
        ? (_housings.isEmpty
              ? [AppConstants.defaultHousingId]
              : _housings.toList())
        : const <String>[];
    Navigator.pop(
      context,
      AccountFormResult(
        employeeUid: _adding ? _employeeUid : widget.initial?.employeeUid,
        displayName: name,
        role: _role,
        teamIds: _role == AuthRole.siteSupervisor ? _teams.toList() : const [],
        housingIds: effectiveHousings,
      ),
    );
  }

  @override
  Widget build(BuildContext context) => AlertDialog(
    title: Text(
      _adding ? AdminStrings.addUser(_ar) : AdminStrings.editUser(_ar),
    ),
    content: SizedBox(
      width: 420,
      child: SingleChildScrollView(
        padding: EdgeInsets.only(
          bottom: MediaQuery.viewInsetsOf(context).bottom + AppTokens.space16,
        ),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            if (_adding)
              DropdownButtonFormField<String>(
                isExpanded: true,
                initialValue: _employeeUid,
                decoration: InputDecoration(
                  labelText: AdminStrings.employeeLabel(_ar),
                ),
                items: [
                  for (final e in widget.employees)
                    DropdownMenuItem(
                      value: e.$1,
                      child: Text(e.$2, overflow: TextOverflow.ellipsis),
                    ),
                ],
                onChanged: (uid) => setState(() {
                  _employeeUid = uid;
                  final match = widget.employees.where((e) => e.$1 == uid);
                  if (match.isNotEmpty) _name.text = match.first.$2;
                }),
              ),
            TextField(
              controller: _name,
              decoration: InputDecoration(
                labelText: AdminStrings.displayNameLabel(_ar),
              ),
            ),
            DropdownButtonFormField<AuthRole>(
              isExpanded: true,
              initialValue: _role,
              decoration: InputDecoration(
                labelText: AdminStrings.roleLabel(_ar),
              ),
              items: [
                for (final r in AuthRole.values)
                  DropdownMenuItem(
                    value: r,
                    child: Text(
                      r.label(arabic: _ar),
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
              ],
              onChanged: (r) => setState(() => _role = r ?? _role),
            ),
            if (_role == AuthRole.siteSupervisor)
              _scopeList(widget.teams, _teams, AdminStrings.assignedTeams(_ar)),
            if (_role == AuthRole.housingSupervisor)
              _scopeList(
                widget.housings,
                _housings,
                AdminStrings.assignedHousing(_ar),
              ),
            if (_error != null)
              Padding(
                padding: const EdgeInsets.only(top: 12),
                child: Text(
                  _error!,
                  style: const TextStyle(color: AppTokens.statusUnknown),
                ),
              ),
          ],
        ),
      ),
    ),
    actions: [
      TextButton(
        onPressed: () => Navigator.pop(context),
        child: Text(AppStrings.cancel(_ar)),
      ),
      FilledButton(onPressed: _submit, child: Text(AppStrings.save(_ar))),
    ],
  );

  Widget _scopeList(
    List<ScopeOption> options,
    Set<String> selection,
    String title,
  ) => ExpansionTile(
    title: Text(title),
    initiallyExpanded: true,
    children: [
      for (final o in options)
        CheckboxListTile(
          value: selection.contains(o.$1),
          title: Text(o.$2),
          onChanged: (checked) => setState(
            () =>
                checked == true ? selection.add(o.$1) : selection.remove(o.$1),
          ),
        ),
    ],
  );
}
</file>

<file path="lib/app/accounts/accounts_admin_controller.dart">
import 'package:radar_labor/core/auth/account_provisioning_repository.dart';
import 'package:radar_labor/core/auth/auth_role.dart';
import 'package:radar_labor/core/auth/local_account.dart';
import 'package:radar_labor/core/auth/local_auth_repository.dart';
import 'package:radar_labor/core/constants/app_constants.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:radar_labor/features/roster/data/workforce_file_picker.dart';
import 'package:radar_labor/features/roster/data/workforce_import_repository.dart';
import 'package:radar_labor/features/roster/domain/supervisor_role_resolver.dart';
import 'package:radar_labor/features/roster/domain/workforce_import_parser.dart';
import 'package:radar_labor/features/roster/domain/workforce_row.dart';

/// Reference data shown on the names & roles administration screen.
final class AccountsAdminData {
  const AccountsAdminData({
    required this.accounts,
    required this.employees,
    required this.teams,
    required this.housings,
  });

  final List<LocalAccount> accounts;
  final List<Employee> employees;
  final List<Team> teams;
  final List<Housing> housings;

  /// Whether any supervisor can already pick their name on the login screen.
  bool get hasSupervisors => accounts.any(
    (a) =>
        a.role == AuthRole.siteSupervisor ||
        a.role == AuthRole.housingSupervisor,
  );
}

/// Parsed roster awaiting the administrator's confirmation.
final class ImportPreview {
  const ImportPreview({required this.rows, required this.supervisorCount});
  final List<WorkforceRow> rows;
  final int supervisorCount;
}

/// Values entered in the add/edit account dialog.
final class AccountFormResult {
  const AccountFormResult({
    required this.displayName,
    required this.role,
    this.employeeUid,
    this.teamIds = const [],
    this.housingIds = const [],
  });

  final String? employeeUid;
  final String displayName;
  final AuthRole role;
  final List<String> teamIds;
  final List<String> housingIds;
}

/// Thrown when removing the only active project manager account.
final class LastManagerException implements Exception {
  const LastManagerException();
}

/// Orchestrates names/roles administration so the screen stays presentational.
final class AccountsAdminController {
  AccountsAdminController(this._database)
    : _auth = LocalAuthRepository(_database),
      _importer = WorkforceImportRepository(_database);

  final AppDatabase _database;
  final LocalAuthRepository _auth;
  final WorkforceImportRepository _importer;

  Future<AccountsAdminData> load() async {
    final db = _database;
    final accounts = await _auth.accounts(activeOnly: true);
    final employees = await (db.select(
      db.employees,
    )..where((r) => r.isActive)).get();
    final teams = await (db.select(db.teams)..where((r) => r.isActive)).get();
    final housings = await (db.select(
      db.housings,
    )..where((r) => r.isActive)).get();
    return AccountsAdminData(
      accounts: accounts,
      employees: employees,
      teams: teams,
      housings: housings,
    );
  }

  /// Opens the local file picker and parses the roster; null when cancelled.
  Future<ImportPreview?> pickImport() async {
    final file = await WorkforceFilePicker().pick();
    if (file == null) return null;
    final rows = const WorkforceImportParser().parse(
      filename: file.name,
      bytes: file.bytes,
    );
    const resolver = SupervisorRoleResolver();
    final supervisors = rows.where((r) => resolver.resolve(r) != null).length;
    return ImportPreview(rows: rows, supervisorCount: supervisors);
  }

  Future<WorkforceImportResult> commitImport(ImportPreview preview) =>
      _importer.commit(preview.rows);

  Future<void> create(AccountFormResult form) {
    final effectiveHousingIds = form.role == AuthRole.housingSupervisor
        ? (form.housingIds.isEmpty
              ? [AppConstants.defaultHousingId]
              : (form.housingIds.contains(AppConstants.defaultHousingId)
                    ? form.housingIds
                    : [AppConstants.defaultHousingId, ...form.housingIds]))
        : form.housingIds;
    return _auth.createAccount(
      employeeUid: form.employeeUid,
      displayName: form.displayName,
      role: form.role,
      teamIds: form.teamIds,
      housingIds: effectiveHousingIds,
    );
  }

  Future<void> update(LocalAccount account, AccountFormResult form) async {
    if (form.role != AuthRole.projectManager) await _guardLastManager(account);
    await AccountProvisioningRepository(_database, _auth).updateAccount(
      accountId: account.id,
      displayName: form.displayName,
      role: form.role,
      teamIds: form.teamIds,
      housingIds: form.housingIds,
    );
  }

  Future<void> resetPassword(String accountId) =>
      _auth.resetPassword(accountId);

  /// Removes the account from the sign-in list (soft delete keeps history).
  Future<void> remove(LocalAccount account) async {
    await _guardLastManager(account);
    await _auth.deactivateAccount(account.id);
  }

  Future<void> _guardLastManager(LocalAccount account) async {
    if (account.role != AuthRole.projectManager) return;
    final managers = (await _auth.accounts(activeOnly: true))
        .where((a) => a.role == AuthRole.projectManager);
    if (managers.length <= 1) throw const LastManagerException();
  }
}
</file>

<file path="lib/app/login/login_flow_notifier.dart">
import 'dart:async';

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:radar_labor/core/auth/auth_role.dart';
import 'package:radar_labor/core/auth/local_account.dart';
import 'package:radar_labor/core/l10n/name_collation.dart';

/// Immutable state for the 3-step Role -> Name -> Password login flow (PRD §23.2, D-20).
final class LoginFlowState {
  const LoginFlowState({
    this.accounts = const <LocalAccount>[],
    this.selectedRole,
    this.selectedAccountId,
    this.rememberedAccountId,
    this.isRememberedMode = false,
  });

  final List<LocalAccount> accounts;
  final AuthRole? selectedRole;
  final String? selectedAccountId;
  final String? rememberedAccountId;
  final bool isRememberedMode;

  LocalAccount? get rememberedAccount {
    final id = rememberedAccountId;
    if (id == null) return null;
    for (final account in accounts) {
      if (account.id == id && account.active) return account;
    }
    return null;
  }

  bool get isSupervisorRole =>
      selectedRole == AuthRole.siteSupervisor ||
      selectedRole == AuthRole.housingSupervisor;

  /// Active accounts matching [selectedRole] sorted deterministically by name.
  List<LocalAccount> get accountsForRole {
    final role = selectedRole;
    if (role == null) return const <LocalAccount>[];
    final filtered = [
      for (final account in accounts)
        if (account.active && account.role == role) account,
    ];
    filtered.sort(
      (a, b) =>
          NameCollation.sortKey(a.displayName)
              .compareTo(NameCollation.sortKey(b.displayName)),
    );
    return List.unmodifiable(filtered);
  }

  /// Supervisors always see a name picker; non-supervisors only see it when >1 account exists (PRD §23.2).
  bool get showNameDropdown {
    if (selectedRole == null) return false;
    final list = accountsForRole;
    if (list.isEmpty) return false;
    if (isSupervisorRole) return true;
    return list.length > 1;
  }

  LocalAccount? get selectedAccount {
    final id = selectedAccountId;
    if (id == null) return null;
    for (final account in accountsForRole) {
      if (account.id == id) return account;
    }
    return null;
  }

  LoginFlowState copyWith({
    List<LocalAccount>? accounts,
    AuthRole? Function()? selectedRole,
    String? Function()? selectedAccountId,
    String? Function()? rememberedAccountId,
    bool? isRememberedMode,
  }) => LoginFlowState(
    accounts: accounts ?? this.accounts,
    selectedRole: selectedRole != null ? selectedRole() : this.selectedRole,
    selectedAccountId: selectedAccountId != null
        ? selectedAccountId()
        : this.selectedAccountId,
    rememberedAccountId: rememberedAccountId != null
        ? rememberedAccountId()
        : this.rememberedAccountId,
    isRememberedMode: isRememberedMode ?? this.isRememberedMode,
  );
}

/// Controller for the Role -> Name -> Password login flow (PRD §17.4, §23.2).
final class LoginFlowNotifier {
  LoginFlowNotifier([List<LocalAccount> initialAccounts = const []])
    : _state = LoginFlowState(accounts: List.unmodifiable(initialAccounts));

  final StreamController<LoginFlowState> _controller =
      StreamController<LoginFlowState>.broadcast();
  LoginFlowState _state;

  LoginFlowState get state => _state;
  Stream<LoginFlowState> get stream => _controller.stream;

  void _emit(LoginFlowState next) {
    _state = next;
    if (!_controller.isClosed) {
      _controller.add(next);
    }
  }

  void setAccounts(List<LocalAccount> accounts, {String? rememberedAccountId}) {
    final validRemembered =
        rememberedAccountId != null &&
        accounts.any((a) => a.id == rememberedAccountId && a.active);
    final next = _state.copyWith(
      accounts: List.unmodifiable(accounts),
      rememberedAccountId: () => validRemembered ? rememberedAccountId : null,
      isRememberedMode: validRemembered,
    );
    final role = next.selectedRole;
    if (role == null) {
      _emit(next);
      return;
    }
    _emit(_applyRoleSelection(next, role));
  }

  void switchAccount() {
    _emit(
      _state.copyWith(isRememberedMode: false, rememberedAccountId: () => null),
    );
  }

  void selectRole(AuthRole role) {
    _emit(_applyRoleSelection(_state, role));
  }

  void clearRole() {
    _emit(
      _state.copyWith(selectedRole: () => null, selectedAccountId: () => null),
    );
  }

  void selectAccount(String? accountId) {
    final valid = _state.accountsForRole.any((a) => a.id == accountId);
    _emit(_state.copyWith(selectedAccountId: () => valid ? accountId : null));
  }

  void dispose() {
    _controller.close();
  }

  LoginFlowState _applyRoleSelection(LoginFlowState base, AuthRole role) {
    final withRole = base.copyWith(selectedRole: () => role);
    final roleAccounts = withRole.accountsForRole;
    if (roleAccounts.isEmpty) {
      return withRole.copyWith(selectedAccountId: () => null);
    }
    return withRole.copyWith(selectedAccountId: () => roleAccounts.first.id);
  }
}

final loginFlowNotifierProvider = Provider.autoDispose<LoginFlowNotifier>((
  ref,
) {
  final notifier = LoginFlowNotifier();
  ref.onDispose(notifier.dispose);
  return notifier;
});
</file>

<file path="lib/app/screens/entities_screen.dart">
import 'package:drift/drift.dart' as drift;
import 'package:material_ui/material_ui.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:radar_labor/core/l10n/app_strings.dart';
import 'package:uuid/uuid.dart';

/// Screen for viewing and managing organizational entities (Teams or Housings).
final class EntitiesScreen extends StatefulWidget {
  const EntitiesScreen({
    required this.database,
    required this.arabic,
    required this.teams,
    super.key,
  });

  final AppDatabase database;
  final bool arabic;
  final bool teams;

  @override
  State<EntitiesScreen> createState() => _EntitiesScreenState();
}

final class _EntitiesScreenState extends State<EntitiesScreen> {
  Future<void> _add() async {
    final ar = TextEditingController();
    final en = TextEditingController();

    final title = widget.teams
        ? AppStrings.addTeam(widget.arabic)
        : AppStrings.addHousing(widget.arabic);

    final saved = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(title),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(
              controller: ar,
              decoration: InputDecoration(
                labelText: AppStrings.arabicName(widget.arabic),
              ),
            ),
            TextField(
              controller: en,
              decoration: InputDecoration(
                labelText: AppStrings.englishName(widget.arabic),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: Text(AppStrings.cancel(widget.arabic)),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(context, true),
            child: Text(AppStrings.save(widget.arabic)),
          ),
        ],
      ),
    );

    if (saved != true || ar.text.trim().isEmpty) return;
    final id = const Uuid().v4();

    if (widget.teams) {
      await widget.database
          .into(widget.database.teams)
          .insert(
            TeamsCompanion.insert(
              teamId: id,
              nameAr: ar.text.trim(),
              nameEn: drift.Value(
                en.text.trim().isEmpty ? null : en.text.trim(),
              ),
            ),
          );
    } else {
      await widget.database
          .into(widget.database.housings)
          .insert(
            HousingsCompanion.insert(
              housingId: id,
              nameAr: ar.text.trim(),
              nameEn: drift.Value(
                en.text.trim().isEmpty ? null : en.text.trim(),
              ),
            ),
          );
    }
  }

  @override
  Widget build(BuildContext context) {
    final stream = widget.teams
        ? widget.database
              .select(widget.database.teams)
              .watch()
              .map(
                (rows) => rows
                    .map(
                      (row) => widget.arabic
                          ? row.nameAr
                          : (row.nameEn ?? row.nameAr),
                    )
                    .toList(),
              )
        : widget.database
              .select(widget.database.housings)
              .watch()
              .map(
                (rows) => rows
                    .map(
                      (row) => widget.arabic
                          ? row.nameAr
                          : (row.nameEn ?? row.nameAr),
                    )
                    .toList(),
              );

    return Scaffold(
      backgroundColor: Colors.transparent,
      floatingActionButton: widget.teams
          ? FloatingActionButton.extended(
              onPressed: _add,
              icon: const Icon(Icons.add),
              label: Text(AppStrings.add(widget.arabic)),
            )
          : null,
      body: StreamBuilder<List<String>>(
        stream: stream,
        builder: (context, state) {
          final rows = state.data ?? [];
          if (rows.isEmpty) {
            return Center(child: Text(AppStrings.noDataYet(widget.arabic)));
          }
          return ListView.builder(
            padding: const EdgeInsets.only(bottom: 100),
            itemCount: rows.length,
            itemBuilder: (context, i) {
              final name = rows[i];
              return Card(
                child: ListTile(
                  leading: Icon(
                    widget.teams ? Icons.groups_2 : Icons.apartment,
                  ),
                  title: Text(name),
                ),
              );
            },
          );
        },
      ),
    );
  }
}
