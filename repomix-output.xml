<file path="lib/features/operations/data/site_attendance_save_builder.dart">
import 'package:radar_labor/core/events/event_repository.dart';
import 'package:radar_labor/core/status/status_models.dart';
import 'package:radar_labor/features/operations/domain/attendance_ledger.dart';
import 'package:radar_labor/features/operations/domain/conflict_detector.dart';
import 'package:radar_labor/features/operations/domain/ledger_undo_plan.dart';
import 'package:radar_labor/features/operations/domain/site_attendance_store.dart';

/// Builds the atomic event batch and [LedgerUndoPlan] for a site attendance save.
final class SiteAttendanceSaveBuilder {
  const SiteAttendanceSaveBuilder._();

  static ({
    Set<String> finalSelectedIds,
    LedgerUndoPlan undoPlan,
    List<EventDraft> drafts,
  })
  build({
    required PreparedSiteSave prepared,
    required Map<String, ConflictResolutionChoice> resolutions,
    required AttendanceLedger ledger,
    required String actorUserId,
  }) {
    final finalSelectedIds = Set<String>.from(prepared.selectedWorkerIds);
    for (final c in prepared.conflicts) {
      if (resolutions[c.worker.id] == ConflictResolutionChoice.skipWorker) {
        finalSelectedIds.remove(c.worker.id);
      }
    }

    final previousPresent = ledger.presentWorkerIdsForTeam(prepared.team.id);
    final teamWorkerIds = {...previousPresent, ...finalSelectedIds};

    final touchedKeys = <LedgerKey>[
      for (final c in prepared.conflicts)
        if (resolutions[c.worker.id] ==
            ConflictResolutionChoice.transferDuringDay)
          LedgerKey(type: EventType.resolution, employeeUid: c.worker.id)
        else if (resolutions[c.worker.id] ==
            ConflictResolutionChoice.removeFromOtherTeam)
          LedgerKey(
            type: EventType.sitePresent,
            employeeUid: c.worker.id,
            teamId: c.otherTeamId,
          ),
      for (final id in teamWorkerIds)
        LedgerKey(
          type: EventType.sitePresent,
          employeeUid: id,
          teamId: prepared.team.id,
        ),
      LedgerKey(type: EventType.siteSubmitted, teamId: prepared.team.id),
    ];

    final undoPlan = LedgerUndoPlan.capture(
      businessDate: prepared.date,
      ledger: ledger,
      touchedKeys: touchedKeys,
    );

    final drafts = <EventDraft>[
      for (final c in prepared.conflicts)
        if (resolutions[c.worker.id] ==
            ConflictResolutionChoice.transferDuringDay)
          EventDraft(
            type: EventType.resolution,
            action: EventAction.set,
            businessDate: prepared.date,
            employeeUid: c.worker.id,
            teamId: prepared.team.id,
            userId: actorUserId,
            payload: {'kind': ResolutionKind.movedDuringDay.key},
          )
        else if (resolutions[c.worker.id] ==
            ConflictResolutionChoice.removeFromOtherTeam)
          EventDraft(
            type: EventType.sitePresent,
            action: EventAction.clear,
            businessDate: prepared.date,
            employeeUid: c.worker.id,
            teamId: c.otherTeamId,
            userId: actorUserId,
            payload: const {'reason': 'conflict_correction'},
          ),
      for (final id in teamWorkerIds)
        EventDraft(
          type: EventType.sitePresent,
          action: finalSelectedIds.contains(id)
              ? EventAction.set
              : EventAction.clear,
          businessDate: prepared.date,
          employeeUid: id,
          teamId: prepared.team.id,
          userId: actorUserId,
        ),
      EventDraft(
        type: EventType.siteSubmitted,
        action: EventAction.set,
        businessDate: prepared.date,
        teamId: prepared.team.id,
        userId: actorUserId,
        payload: {'presentCount': finalSelectedIds.length},
      ),
    ];

    return (
      finalSelectedIds: Set.unmodifiable(finalSelectedIds),
      undoPlan: undoPlan,
      drafts: List.unmodifiable(drafts),
    );
  }

  static List<EventDraft> buildUndoDrafts({
    required LedgerUndoPlan plan,
    required String actorUserId,
  }) => [
    for (final entry in plan.entries)
      EventDraft(
        type: entry.key.type,
        action: entry.restoreAction,
        businessDate: plan.businessDate,
        employeeUid: entry.key.employeeUid,
        teamId: entry.key.teamId,
        housingId: entry.key.housingId,
        userId: actorUserId,
        payload: {
          if (entry.key.type == EventType.resolution &&
              entry.resolutionKind != null)
            'kind': entry.resolutionKind!.key,
        },
      ),
  ];
}
</file>

<file path="lib/features/operations/data/team_setup_repository.dart">
import 'dart:async';

import 'package:drift/drift.dart';
import 'package:radar_labor/core/auth/scope_snapshot.dart';
import 'package:radar_labor/core/constants/operations_constants.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:radar_labor/core/l10n/name_collation.dart';
import 'package:radar_labor/features/operations/domain/operation_failure.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';
import 'package:radar_labor/features/operations/domain/scope_guard.dart';
import 'package:radar_labor/features/operations/domain/team_setup_store.dart';
import 'package:uuid/uuid.dart';

/// Atomic repository for supervisor team setup wizard and member editing (PRD §7.3, §7.4).
final class TeamSetupRepository implements TeamSetupStore {
  const TeamSetupRepository({required this.database, this.uuid = const Uuid()});

  final AppDatabase database;
  final Uuid uuid;

  static final RegExp _whitespace = RegExp(r'\s+');

  @override
  Stream<List<SelectableWorker>> watchActiveWorkersWithTeams() {
    late StreamController<List<SelectableWorker>> controller;
    StreamSubscription<List<Employee>>? empSub;
    StreamSubscription<List<Team>>? teamSub;
    List<Employee>? employees;
    List<Team>? teams;

    void emit() {
      if (employees == null || teams == null) return;
      final teamMap = <String, Team>{for (final t in teams!) t.teamId: t};
      final items = <SelectableWorker>[
        for (final emp in employees!)
          SelectableWorker(
            id: emp.employeeUid,
            code: emp.employeeCode,
            nameAr: emp.fullNameAr,
            nameEn: emp.fullNameEn,
            currentTeamId: emp.currentTeamId,
            currentTeamNameAr: teamMap[emp.currentTeamId]?.nameAr,
            currentTeamNameEn: teamMap[emp.currentTeamId]?.nameEn,
          ),
      ];
      controller.add(List.unmodifiable(items));
    }

    controller = StreamController<List<SelectableWorker>>(
      onListen: () {
        empSub =
            (database.select(
              database.employees,
            )..where((e) => e.isActive.equals(true))).watch().listen((rows) {
              employees = rows;
              emit();
            }, onError: controller.addError);
        teamSub = database.select(database.teams).watch().listen((rows) {
          teams = rows;
          emit();
        }, onError: controller.addError);
      },
      onCancel: () async {
        await empSub?.cancel();
        await teamSub?.cancel();
      },
    );
    return controller.stream;
  }

  /// Validates [nameAr] and [nameEn] against length and duplicate rules (PRD §7.2).
  Future<({String nameAr, String? nameEn})> validateTeamName({
    required String nameAr,
    String? nameEn,
  }) async {
    final normAr = nameAr.trim().replaceAll(_whitespace, ' ');
    final normEn = nameEn?.trim().replaceAll(_whitespace, ' ');
    if (normAr.isEmpty ||
        normAr.length > OperationsConstants.teamNameMaxLength) {
      throw const OperationException(TeamNameInvalid());
    }
    if (normEn != null &&
        normEn.length > OperationsConstants.teamNameMaxLength) {
      throw const OperationException(TeamNameInvalid());
    }

    final existingTeams = await database.select(database.teams).get();
    final keyAr = NameCollation.sortKey(normAr);
    final keyEn = (normEn != null && normEn.isNotEmpty)
        ? NameCollation.sortKey(normEn)
        : null;

    for (final existing in existingTeams) {
      if (NameCollation.sortKey(existing.nameAr) == keyAr) {
        throw const OperationException(TeamNameExists());
      }
      if (keyEn != null &&
          existing.nameEn != null &&
          NameCollation.sortKey(existing.nameEn!) == keyEn) {
        throw const OperationException(TeamNameExists());
      }
    }
    return (
      nameAr: normAr,
      nameEn: (normEn == null || normEn.isEmpty) ? null : normEn,
    );
  }

  @override
  Future<EntityOption> createTeam({
    required ActorContext actor,
    required String nameAr,
    String? nameEn,
    required Set<String> workerIds,
  }) async {
    ScopeGuard.guardTeamSetup(actor);
    final validated = await validateTeamName(nameAr: nameAr, nameEn: nameEn);
    final teamId = uuid.v4();

    return database.transaction(() async {
      // Re-check duplicate name inside transaction
      final existingTeams = await database.select(database.teams).get();
      final keyAr = NameCollation.sortKey(validated.nameAr);
      for (final existing in existingTeams) {
        if (NameCollation.sortKey(existing.nameAr) == keyAr) {
          throw const OperationException(TeamNameExists());
        }
      }

      await database
          .into(database.teams)
          .insert(
            TeamsCompanion.insert(
              teamId: teamId,
              nameAr: validated.nameAr,
              nameEn: Value(validated.nameEn),
              supervisorUserId: Value(actor.userId),
              isActive: const Value(true),
            ),
          );

      // Programmatic guard against duplicate user_scopes row (PRD §2, §7.3)
      final existingScope =
          await (database.select(database.userScopes)..where(
                (s) =>
                    s.userId.equals(actor.userId) &
                    s.scopeType.equals('team') &
                    s.scopeId.equals(teamId),
              ))
              .getSingleOrNull();
      if (existingScope == null) {
        await database
            .into(database.userScopes)
            .insert(
              UserScopesCompanion.insert(
                id: uuid.v4(),
                userId: actor.userId,
                scopeType: 'team',
                scopeId: teamId,
              ),
            );
      }

      if (workerIds.isNotEmpty) {
        final rows = await (database.select(
          database.employees,
        )..where((e) => e.employeeUid.isIn(workerIds.toList()))).get();
        final byId = <String, Employee>{for (final r in rows) r.employeeUid: r};
        final unavailable = <String>{};
        for (final wid in workerIds) {
          final emp = byId[wid];
          if (emp == null || !emp.isActive || emp.currentTeamId != null) {
            unavailable.add(wid);
          }
        }
        if (unavailable.isNotEmpty) {
          throw OperationException(
            WorkersUnavailable(Set.unmodifiable(unavailable)),
          );
        }

        for (final emp in rows) {
          await (database.update(
            database.employees,
          )..where((e) => e.employeeUid.equals(emp.employeeUid))).write(
            EmployeesCompanion(
              currentTeamId: Value(teamId),
              rowVersion: Value(emp.rowVersion + 1),
            ),
          );
        }
      }

      return EntityOption(
        id: teamId,
        nameAr: validated.nameAr,
        nameEn: validated.nameEn,
      );
    });
  }

  @override
  Future<void> updateTeamMembers({
    required ActorContext actor,
    required ScopeSnapshot scope,
    required String teamId,
    required Set<String> workerIds,
  }) async {
    ScopeGuard.guardTeamEdit(actor: actor, scope: scope, teamId: teamId);

    await database.transaction(() async {
      final scopeRow =
          await (database.select(database.userScopes)..where(
                (s) =>
                    s.userId.equals(actor.userId) &
                    s.scopeType.equals('team') &
                    s.scopeId.equals(teamId),
              ))
              .getSingleOrNull();
      if (scopeRow == null) {
        throw const OperationException(ScopeChanged());
      }

      final currentMembers = await (database.select(
        database.employees,
      )..where((e) => e.currentTeamId.equals(teamId))).get();
      final currentMemberIds = {for (final m in currentMembers) m.employeeUid};

      final toRemove = currentMemberIds.difference(workerIds);
      final toAdd = workerIds.difference(currentMemberIds);

      if (toAdd.isNotEmpty) {
        final candidates = await (database.select(
          database.employees,
        )..where((e) => e.employeeUid.isIn(toAdd.toList()))).get();
        final byId = <String, Employee>{
          for (final c in candidates) c.employeeUid: c,
        };
        final unavailable = <String>{};
        for (final wid in toAdd) {
          final emp = byId[wid];
          if (emp == null ||
              !emp.isActive ||
              (emp.currentTeamId != null && emp.currentTeamId != teamId)) {
            unavailable.add(wid);
          }
        }
        if (unavailable.isNotEmpty) {
          throw OperationException(
            WorkersUnavailable(Set.unmodifiable(unavailable)),
          );
        }
        for (final emp in candidates) {
          await (database.update(
            database.employees,
          )..where((e) => e.employeeUid.equals(emp.employeeUid))).write(
            EmployeesCompanion(
              currentTeamId: Value(teamId),
              rowVersion: Value(emp.rowVersion + 1),
            ),
          );
        }
      }

      for (final emp in currentMembers) {
        if (toRemove.contains(emp.employeeUid)) {
          await (database.update(
            database.employees,
          )..where((e) => e.employeeUid.equals(emp.employeeUid))).write(
            EmployeesCompanion(
              currentTeamId: const Value(null),
              rowVersion: Value(emp.rowVersion + 1),
            ),
          );
        }
      }
    });
  }
}
</file>

<file path="lib/features/operations/domain/attendance_diff.dart">
import 'package:radar_labor/core/l10n/name_collation.dart';
import 'package:radar_labor/core/l10n/operations_strings.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';

/// Source kind for the pre-save comparison baseline (PRD §8.1, §10).
enum BaselineKind { lastSave, previousDay, none }

/// Immutable baseline against which current selection changes are measured.
final class AttendanceBaseline {
  const AttendanceBaseline({
    required this.kind,
    this.date,
    this.workerIds = const <String>{},
  });

  final BaselineKind kind;
  final String? date;
  final Set<String> workerIds;
}

/// Pure result of comparing the current selection against an [AttendanceBaseline] (PRD §10).
final class AttendanceDiffResult {
  const AttendanceDiffResult({
    required this.baseline,
    required this.totalPresent,
    required this.addedWorkers,
    required this.removedWorkers,
  });

  final AttendanceBaseline baseline;
  final int totalPresent;
  final List<WorkerOption> addedWorkers;
  final List<WorkerOption> removedWorkers;

  bool get hasChanges => addedWorkers.isNotEmpty || removedWorkers.isNotEmpty;

  String baselineLabel(bool ar) => switch (baseline.kind) {
    BaselineKind.lastSave => OperationsStrings.diffBaselineLastSave(ar),
    BaselineKind.previousDay => OperationsStrings.diffBaselineDate(
      ar,
      baseline.date ?? '',
    ),
    BaselineKind.none => OperationsStrings.diffNoBaseline(ar),
  };

  String totalLine(bool ar) => OperationsStrings.preSaveDiffTotal(
    ar,
    totalPresent,
    addedWorkers.length,
    removedWorkers.length,
  );
}

/// Pure calculator for pre-save attendance differences (PRD §10).
abstract final class AttendanceDiff {
  static AttendanceDiffResult compute({
    required AttendanceBaseline baseline,
    required Set<String> selectedIds,
    required Map<String, WorkerOption> workersById,
    required bool arabic,
  }) {
    if (baseline.kind == BaselineKind.none) {
      return AttendanceDiffResult(
        baseline: baseline,
        totalPresent: selectedIds.length,
        addedWorkers: const <WorkerOption>[],
        removedWorkers: const <WorkerOption>[],
      );
    }

    final addedIds = selectedIds.difference(baseline.workerIds);
    final removedIds = baseline.workerIds.difference(selectedIds);

    final added = _sortedWorkers(addedIds, workersById, arabic);
    final removed = _sortedWorkers(removedIds, workersById, arabic);

    return AttendanceDiffResult(
      baseline: baseline,
      totalPresent: selectedIds.length,
      addedWorkers: List.unmodifiable(added),
      removedWorkers: List.unmodifiable(removed),
    );
  }

  static List<WorkerOption> _sortedWorkers(
    Set<String> ids,
    Map<String, WorkerOption> workersById,
    bool arabic,
  ) {
    final list = <WorkerOption>[
      for (final id in ids)
        if (workersById[id] != null) workersById[id]!,
    ];
    list.sort(
      (a, b) => NameCollation.compareWorkers(
        nameA: a.displayName(arabic: arabic),
        codeA: a.code,
        idA: a.id,
        nameB: b.displayName(arabic: arabic),
        codeB: b.code,
        idB: b.id,
      ),
    );
    return list;
  }
}
</file>

