<file path="lib/features/operations/presentation/state/history_notifier.dart">
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:radar_labor/app/app_providers.dart';
import 'package:radar_labor/core/auth/scope_snapshot.dart';
import 'package:radar_labor/core/constants/operations_constants.dart';
import 'package:radar_labor/features/operations/domain/history_models.dart';
import 'package:radar_labor/features/operations/domain/operation_failure.dart';

/// Immutable UI state for History (PRD §11).
final class HistoryState {
  const HistoryState({
    this.daysWindow = OperationsConstants.historyPageDays,
    this.isLoading = false,
    this.page,
    this.errorMessage,
  });

  final int daysWindow;
  final bool isLoading;
  final HistoryPage? page;
  final String? errorMessage;

  HistoryState copyWith({
    int? daysWindow,
    bool? isLoading,
    HistoryPage? page,
    String? errorMessage,
    bool clearError = false,
  }) => HistoryState(
    daysWindow: daysWindow ?? this.daysWindow,
    isLoading: isLoading ?? this.isLoading,
    page: page ?? this.page,
    errorMessage: clearError ? null : (errorMessage ?? this.errorMessage),
  );
}

/// Controller for paginated supervisor and admin history (PRD §11).
final class HistoryNotifier extends Notifier<HistoryState> {
  ActorContext? _overrideActor;
  ScopeSnapshot? _overrideScope;

  @override
  HistoryState build() => const HistoryState();

  void setOverrideContext({ActorContext? actor, ScopeSnapshot? scope}) {
    _overrideActor = actor;
    _overrideScope = scope;
  }

  bool get _isArabic => ref.read(appLocaleProvider) == 'ar';

  ({ActorContext actor, ScopeSnapshot scope})? _actorAndScope() {
    if (_overrideActor != null && _overrideScope != null) {
      return (actor: _overrideActor!, scope: _overrideScope!);
    }
    final s = ref.read(currentSessionProvider);
    if (s == null) return null;
    final actor = ActorContext(userId: s.id, role: s.role);
    final scope =
        ref.read(userScopesProvider(s.id)).value ??
        ScopeSnapshot(
          teamIds: s.teamIds.toSet(),
          housingIds: s.housingIds.toSet(),
        );
    return (actor: actor, scope: scope);
  }

  Future<void> refresh() => _load(daysWindow: state.daysWindow);

  Future<void> loadMore() =>
      _load(daysWindow: state.daysWindow + OperationsConstants.historyPageDays);

  Future<void> _load({required int daysWindow}) async {
    final ctx = _actorAndScope();
    if (ctx == null) return;
    state = state.copyWith(
      daysWindow: daysWindow,
      isLoading: true,
      clearError: true,
    );
    try {
      final page = await ref
          .read(historyStoreProvider)
          .loadHistory(
            actor: ctx.actor,
            scope: ctx.scope,
            daysWindow: daysWindow,
            arabic: _isArabic,
          );
      state = state.copyWith(isLoading: false, page: page, clearError: true);
    } on OperationException catch (error) {
      state = state.copyWith(
        isLoading: false,
        errorMessage: OperationFailureMessage.of(error.failure, _isArabic),
      );
    }
  }
}

final historyNotifierProvider = NotifierProvider<HistoryNotifier, HistoryState>(
  HistoryNotifier.new,
);
</file>

<file path="lib/features/operations/presentation/state/housing_check_notifier.dart">
import 'dart:async';

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:radar_labor/app/app_providers.dart';
import 'package:radar_labor/core/constants/operations_constants.dart';
import 'package:radar_labor/core/events/event_repository.dart';
import 'package:radar_labor/core/time/business_date.dart';
import 'package:radar_labor/core/time/clock.dart';
import 'package:radar_labor/features/operations/domain/attendance_ledger.dart';
import 'package:radar_labor/features/operations/domain/housing_draft_store.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';
import 'package:radar_labor/features/operations/domain/operations_store.dart';
import 'package:radar_labor/features/operations/presentation/state/housing_check_state.dart';
import 'package:radar_labor/features/operations/presentation/state/operations_controller.dart';

/// Riverpod notifier managing binary housing absence review, drafts, and persistence (Phase 4).
final class HousingCheckNotifier extends Notifier<HousingCheckState> {
  Timer? _draftTimer;

  @override
  HousingCheckState build() {
    ref.onDispose(() => _draftTimer?.cancel());
    final clock = ref.read(clockProvider);
    final today = businessDateFor(clock.nowUtc());
    return HousingCheckState(selectedDate: today, todayDate: today);
  }

  Clock get _clock => ref.read(clockProvider);
  OperationsStore get _opsStore => ref.read(operationsRepositoryProvider);
  HousingDraftStore get _draftStore => ref.read(housingDraftStoreProvider);
  EventRepository get _eventRepo => ref.read(eventRepositoryProvider);

  Future<void> ensureInitialHousing(List<EntityOption> housings) async {
    if (housings.isEmpty) {
      if (state.selectedHousing != null) {
        state = state.copyWith(clearSelectedHousing: true, rows: const []);
      }
      return;
    }
    final cur = state.selectedHousing;
    if (cur != null && housings.any((h) => h.id == cur.id)) {
      if (state.rows.isEmpty && !state.isLoading) {
        await _load(housing: cur, date: state.selectedDate);
      }
      return;
    }
    await selectHousing(housings.first);
  }

  Future<void> selectHousing(EntityOption? housing) async {
    await flushDraft();
    if (housing != null) {
      return _load(housing: housing, date: state.selectedDate);
    }
    state = state.copyWith(
      clearSelectedHousing: true,
      rows: const [],
      clearError: true,
    );
  }

  void setSearchQuery(String query) {
    state = state.copyWith(searchQuery: query);
  }

  void toggleAbsent(String workerId) {
    final updated = [
      for (final r in state.rows)
        if (r.worker.id == workerId)
          r.copyWith(
            reviewState: r.reviewState == HousingReviewState.absent
                ? HousingReviewState.reviewedPresent
                : HousingReviewState.absent,
          )
        else
          r,
    ];
    _updateRows(updated);
  }

  void setReviewState(String workerId, HousingReviewState newState) {
    final updated = [
      for (final r in state.rows)
        if (r.worker.id == workerId) r.copyWith(reviewState: newState) else r,
    ];
    _updateRows(updated);
  }

  void markRemainingAsReviewed() {
    final updated = [
      for (final r in state.rows)
        if (r.reviewState == HousingReviewState.unreviewed)
          r.copyWith(reviewState: HousingReviewState.reviewedPresent)
        else
          r,
    ];
    _updateRows(updated);
  }

  void markAllReviewed() {
    final updated = [
      for (final r in state.rows)
        r.copyWith(reviewState: HousingReviewState.reviewedPresent),
    ];
    _updateRows(updated);
  }

  void clearAllReviews() {
    final updated = [
      for (final r in state.rows)
        r.copyWith(reviewState: HousingReviewState.unreviewed),
    ];
    _updateRows(updated);
  }

  void _updateRows(List<HousingWorkerRow> rows) {
    state = state.copyWith(rows: List.unmodifiable(rows), clearError: true);
    _draftTimer?.cancel();
    _draftTimer = Timer(
      OperationsConstants.draftDebounce,
      () => unawaited(flushDraft()),
    );
  }

  Future<void> flushDraft() async {
    final pending = _draftTimer;
    if (pending != null && pending.isActive) pending.cancel();
    final housing = state.selectedHousing;
    if (housing == null || state.rows.isEmpty || state.hasSavedRecordToday) {
      return;
    }
    await _draftStore.writeDraft(
      housingId: housing.id,
      date: state.selectedDate,
      reviewedWorkerIds: state.reviewedWorkerIds,
      absentWorkerIds: state.absentWorkerIds,
    );
    state = state.copyWith(hasDraftSaved: true);
  }

  Future<void> _load({
    required EntityOption housing,
    required String date,
  }) async {
    final today = businessDateFor(_clock.nowUtc());
    state = state.copyWith(
      selectedHousing: housing,
      selectedDate: date,
      todayDate: today,
      isPastDate: date.compareTo(today) < 0,
      isLoading: true,
      clearError: true,
    );

    try {
      final workers = await _opsStore.watchHousingWorkers(housing.id).first;
      final events = await _eventRepo.readBusinessDate(date);
      final ledger = AttendanceLedger(events);

      if (ledger.isHousingChecked(housing.id)) {
        final absent = ledger.absentWorkerIdsForHousing(housing.id);
        final rows = [
          for (final w in workers)
            HousingWorkerRow(
              worker: w,
              reviewState: absent.contains(w.id)
                  ? HousingReviewState.absent
                  : HousingReviewState.reviewedPresent,
            ),
        ];
        state = state.copyWith(
          isLoading: false,
          rows: List.unmodifiable(rows),
          hasSavedRecordToday: true,
          hasDraftSaved: false,
        );
        return;
      }

      final draft = await _draftStore.readDraft(
        housingId: housing.id,
        date: date,
      );
      if (draft != null) {
        final absentSet = draft.absentWorkerIds.toSet();
        final rows = [
          for (final w in workers)
            HousingWorkerRow(
              worker: w,
              reviewState: absentSet.contains(w.id)
                  ? HousingReviewState.absent
                  : HousingReviewState.reviewedPresent,
            ),
        ];
        state = state.copyWith(
          isLoading: false,
          rows: List.unmodifiable(rows),
          hasSavedRecordToday: false,
          hasDraftSaved: true,
        );
        return;
      }

      final rows = [
        for (final w in workers)
          HousingWorkerRow(
            worker: w,
            reviewState: HousingReviewState.reviewedPresent,
          ),
      ];
      state = state.copyWith(
        isLoading: false,
        rows: List.unmodifiable(rows),
        hasSavedRecordToday: false,
        hasDraftSaved: false,
      );
    } on Exception catch (error) {
      state = state.copyWith(isLoading: false, errorMessage: error.toString());
    }
  }

  Future<PreparedHousingCheck?> prepareSave({
    required OperationsController controller,
    required bool arabic,
  }) async {
    await flushDraft();
    final housing = state.selectedHousing;
    if (housing == null) return null;
    return controller.prepareHousingCheck(
      housing: housing,
      absentIds: state.absentWorkerIds,
      arabic: arabic,
    );
  }

  Future<HousingCheckUndo?> confirmSave({
    required OperationsController controller,
    required PreparedHousingCheck check,
  }) async {
    _draftTimer?.cancel();
    state = state.copyWith(isSaving: true, clearError: true);
    try {
      final undo = await controller.saveHousingCheck(check);
      await _draftStore.deleteDraft(
        housingId: check.housing.id,
        date: check.date,
      );
      await _load(housing: check.housing, date: check.date);
      state = state.copyWith(
        isSaving: false,
        lastUndo: undo,
        hasDraftSaved: false,
        hasSavedRecordToday: true,
      );
      return undo;
    } on Exception catch (error) {
      state = state.copyWith(isSaving: false, errorMessage: error.toString());
      return null;
    }
  }

  Future<bool> undoLastSave({required OperationsController controller}) async {
    final undo = state.lastUndo;
    if (undo == null) return false;
    try {
      await controller.undoHousingCheck(undo);
      state = state.copyWith(clearUndo: true);
      if (state.selectedHousing != null) {
        await _load(housing: state.selectedHousing!, date: state.selectedDate);
      }
      return true;
    } on Exception catch (error) {
      state = state.copyWith(errorMessage: error.toString());
      return false;
    }
  }
}

final housingCheckNotifierProvider =
    NotifierProvider<HousingCheckNotifier, HousingCheckState>(
      HousingCheckNotifier.new,
    );
</file>

<file path="lib/features/operations/presentation/state/housing_check_state.dart">
import 'package:radar_labor/features/operations/domain/operations_models.dart';

/// 3-State review model for housing checks (kept for backward compatibility).
enum HousingReviewState { unreviewed, reviewedPresent, absent }

/// Presentation row representing a worker in the housing check.
final class HousingWorkerRow {
  const HousingWorkerRow({
    required this.worker,
    this.reviewState = HousingReviewState.unreviewed,
  });

  const HousingWorkerRow.binary({
    required WorkerOption worker,
    required bool isAbsent,
  }) : this(
         worker: worker,
         reviewState: isAbsent
             ? HousingReviewState.absent
             : HousingReviewState.reviewedPresent,
       );

  final WorkerOption worker;
  final HousingReviewState reviewState;

  bool get isAbsent => reviewState == HousingReviewState.absent;

  HousingWorkerRow copyWith({HousingReviewState? reviewState}) =>
      HousingWorkerRow(
        worker: worker,
        reviewState: reviewState ?? this.reviewState,
      );
}

/// Immutable state for the campus (housing) check workflow.
final class HousingCheckState {
  const HousingCheckState({
    required this.selectedDate,
    required this.todayDate,
    this.selectedHousing,
    this.isLoading = false,
    this.isSaving = false,
    this.isPastDate = false,
    this.searchQuery = '',
    this.rows = const <HousingWorkerRow>[],
    this.hasSavedRecordToday = false,
    this.hasDraftSaved = false,
    this.lastUndo,
    this.errorMessage,
  });

  final EntityOption? selectedHousing;
  final String selectedDate;
  final String todayDate;
  final bool isLoading;
  final bool isSaving;
  final bool isPastDate;
  final String searchQuery;
  final List<HousingWorkerRow> rows;
  final bool hasSavedRecordToday;
  final bool hasDraftSaved;
  final HousingCheckUndo? lastUndo;
  final String? errorMessage;

  int get totalCount => rows.length;
  int get unreviewedCount =>
      rows.where((r) => r.reviewState == HousingReviewState.unreviewed).length;
  int get reviewedCount => rows
      .where((r) => r.reviewState == HousingReviewState.reviewedPresent)
      .length;
  int get absentCount =>
      rows.where((r) => r.reviewState == HousingReviewState.absent).length;

  Set<String> get absentWorkerIds => {
    for (final r in rows)
      if (r.reviewState == HousingReviewState.absent) r.worker.id,
  };

  Set<String> get reviewedWorkerIds => {
    for (final r in rows)
      if (r.reviewState == HousingReviewState.reviewedPresent) r.worker.id,
  };

  List<HousingWorkerRow> get filteredRows {
    if (searchQuery.trim().isEmpty) return rows;
    final q = searchQuery.trim().toLowerCase();
    return rows
        .where((r) {
          final nameAr = r.worker.nameAr.toLowerCase();
          final nameEn = (r.worker.nameEn ?? '').toLowerCase();
          final code = r.worker.code.toLowerCase();
          return nameAr.contains(q) || nameEn.contains(q) || code.contains(q);
        })
        .toList(growable: false);
  }

  HousingCheckState copyWith({
    EntityOption? selectedHousing,
    bool clearSelectedHousing = false,
    String? selectedDate,
    String? todayDate,
    bool? isLoading,
    bool? isSaving,
    bool? isPastDate,
    String? searchQuery,
    List<HousingWorkerRow>? rows,
    bool? hasSavedRecordToday,
    bool? hasDraftSaved,
    HousingCheckUndo? lastUndo,
    bool clearUndo = false,
    String? errorMessage,
    bool clearError = false,
  }) => HousingCheckState(
    selectedHousing: clearSelectedHousing
        ? null
        : (selectedHousing ?? this.selectedHousing),
    selectedDate: selectedDate ?? this.selectedDate,
    todayDate: todayDate ?? this.todayDate,
    isLoading: isLoading ?? this.isLoading,
    isSaving: isSaving ?? this.isSaving,
    isPastDate: isPastDate ?? this.isPastDate,
    searchQuery: searchQuery ?? this.searchQuery,
    rows: rows ?? this.rows,
    hasSavedRecordToday: hasSavedRecordToday ?? this.hasSavedRecordToday,
    hasDraftSaved: hasDraftSaved ?? this.hasDraftSaved,
    lastUndo: clearUndo ? null : (lastUndo ?? this.lastUndo),
    errorMessage: clearError ? null : (errorMessage ?? this.errorMessage),
  );
}
</file>

<file path="lib/features/operations/presentation/state/team_setup_notifier.dart">
import 'dart:async';

import 'package:flutter_riverpod/flutter_riverpod.dart';
