    setState(() => _localValidationError = null);
    final password = _passwordController.text;
    if (password.isEmpty) {
      setState(
        () => _localValidationError = AuthFlowStrings.enterPasswordError(
          widget.arabic,
        ),
      );
      return;
    }
    widget.onSignIn(password);
