  Future<void> seedWorker({
    required String uid,
    required String code,
    required String nameAr,
    String? nameEn,
    String? teamId,
    String? housingId,
    bool isActive = true,
  }) async {
    await database
        .into(database.employees)
        .insert(
          EmployeesCompanion.insert(
            employeeUid: uid,
            employeeCode: code,
            fullNameAr: nameAr,
            fullNameEn: Value(nameEn),
            category: 'general',
            currentTeamId: Value(teamId),
            housingId: Value(housingId),
