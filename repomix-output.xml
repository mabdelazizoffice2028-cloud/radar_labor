<file path="lib/core/auth/scope_snapshot.dart">
import 'package:radar_labor/core/auth/auth_role.dart';
import 'package:radar_labor/core/auth/role_capabilities.dart';

/// Live snapshot of a user's assigned team and housing scopes (PRD §5.4).
final class ScopeSnapshot {
  const ScopeSnapshot({
    this.teamIds = const <String>{},
    this.housingIds = const <String>{},
  });

  final Set<String> teamIds;
  final Set<String> housingIds;

  bool allowsTeam(String teamId) => teamIds.contains(teamId);

  bool allowsHousing(String housingId) => housingIds.contains(housingId);
}

/// Identifies the authenticated actor performing an operation (PRD §5.4).
final class ActorContext {
  const ActorContext({required this.userId, required this.role});

  final String userId;
  final AuthRole role;

  RoleCapabilities get capabilities => role.capabilities;
}
</file>

<file path="lib/core/auth/user_scope_storage.dart">
import 'package:radar_labor/core/constants/app_constants.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:uuid/uuid.dart';

/// Helper to persist user team and housing scopes into Drift database.
Future<void> insertUserScopes(
  AppDatabase database,
  String userId,
  List<String> teamIds,
  List<String> housingIds,
) async {
  const uuid = Uuid();
  for (final (type, sid) in [
    for (final tid in teamIds) (ScopeTypes.team, tid),
    for (final hid in housingIds) (ScopeTypes.housing, hid),
  ]) {
    await database
        .into(database.userScopes)
        .insert(
          UserScopesCompanion.insert(
            id: uuid.v4(),
            userId: userId,
            scopeType: type,
            scopeId: sid,
          ),
        );
  }
}
</file>

