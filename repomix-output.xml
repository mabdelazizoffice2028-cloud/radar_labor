<file path="test/architecture/architecture_test.dart">
import 'dart:io';

import 'package:flutter_test/flutter_test.dart';

final _featureSegment = RegExp(r'features/([a-z0-9_]+)/');

const _impureImports = [
  'package:flutter',
  'dart:ui',
  'package:drift',
  'package:riverpod',
  'package:flutter_riverpod',
  'package:sqlite3',
];

List<File> _sources() {
  final lib = Directory('lib');
  if (!lib.existsSync()) return const [];
  return lib
      .listSync(recursive: true)
      .whereType<File>()
      .where((f) => f.path.endsWith('.dart') && !f.path.endsWith('.g.dart'))
      .toList();
}

String _norm(File file) => file.path.replaceAll(r'\', '/');

List<String> _directives(File file) => file
    .readAsLinesSync()
    .map((l) => l.trimLeft())
    .where((l) => l.startsWith('import ') || l.startsWith('export '))
    .toList();

List<String> _filesWithDirective(
  bool Function(File) scope,
  bool Function(String) isViolation,
) {
  return [
    for (final file in _sources().where(scope))
      if (_directives(file).any(isViolation)) _norm(file),
  ];
}

void main() {
  test('features_doNotImportOtherFeatures', () {
    final violations = <String>[];
    for (final file in _sources()) {
      final owner = _featureSegment.firstMatch(_norm(file))?.group(1);
      if (owner == null) continue;
      final importsOther = _directives(file).any((line) {
        final target = _featureSegment.firstMatch(line)?.group(1);
        return target != null && target != owner;
      });
      if (importsOther) violations.add(_norm(file));
    }
    expect(violations, isEmpty);
  });

  test('coreStatus_isPureDart', () {
    final violations = _filesWithDirective(
      (f) => _norm(f).contains('lib/core/status/'),
      (line) => _impureImports.any(line.contains),
    );
    expect(violations, isEmpty);
  });

  test('widgetFiles_doNotImportDatabaseOrSupabaseOrDrift', () {
    final violations = _filesWithDirective(
      (f) {
        final path = _norm(f);
        return path.contains('/presentation/') || path.contains('lib/core/ui/');
      },
      (line) =>
          line.contains('core/database') ||
          line.contains('supabase') ||
          line.contains('package:drift'),
    );
    expect(violations, isEmpty);
  });

  test('flutterMaterialAndCupertino_areNeverImported', () {
    final violations = _filesWithDirective(
      (_) => true,
      (line) =>
          line.contains('package:flutter/material.dart') ||
          line.contains('package:flutter/cupertino.dart'),
    );
    expect(violations, isEmpty);
  });

  test('systemClock_isReadOnlyInsideCoreTime', () {
    final violations = _sources()
        .where((f) => !_norm(f).contains('lib/core/time/'))
        .where((f) => f.readAsStringSync().contains('DateTime.now('))
        .map(_norm)
        .toList();
    expect(violations, isEmpty);
  });
}
</file>

<file path="test/core/auth/account_provisioning_test.dart">
import 'package:drift/native.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:radar_labor/core/auth/account_provisioning_repository.dart';
import 'package:radar_labor/core/auth/auth_role.dart';
import 'package:radar_labor/core/auth/local_auth_repository.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:radar_labor/features/roster/data/workforce_import_repository.dart';
import 'package:radar_labor/features/roster/domain/supervisor_role_resolver.dart';
import 'package:radar_labor/features/roster/domain/workforce_row.dart';

void main() {
  late AppDatabase db;
  late LocalAuthRepository auth;
  late AccountProvisioningRepository provisioning;

  setUp(() {
    db = AppDatabase(NativeDatabase.memory());
    auth = LocalAuthRepository(db);
    provisioning = AccountProvisioningRepository(db, auth);
  });

  tearDown(() => db.close());

  test('ensureAdminAccounts creates PM and HR on empty database', () async {
    expect(await auth.accounts(), isEmpty);
    await provisioning.ensureAdminAccounts();

    final accounts = await auth.accounts();
    expect(accounts.length, 2);
    expect(
      accounts.any(
        (a) => a.role == AuthRole.projectManager && a.mustChangePassword,
      ),
      isTrue,
    );
    expect(
      accounts.any((a) => a.role == AuthRole.hr && a.mustChangePassword),
      isTrue,
    );

    // Idempotent: does not duplicate
    await provisioning.ensureAdminAccounts();
    expect((await auth.accounts()).length, 2);
  });

  test('SupervisorRoleResolver detects site and campus supervisors', () {
    const resolver = SupervisorRoleResolver();

    expect(
      resolver.resolve(
        const WorkforceRow(
          code: '1',
          name: 'علي',
          designation: 'Worker',
          supplier: '',
          role: 'Site Supervisor',
        ),
      ),
      AuthRole.siteSupervisor,
    );

    expect(
      resolver.resolve(
        const WorkforceRow(
          code: '2',
          name: 'سالم',
          designation: 'Campus Supervisor',
          supplier: '',
        ),
      ),
      AuthRole.housingSupervisor,
    );

    expect(
      resolver.resolve(
        const WorkforceRow(
          code: '3',
          name: 'محمد',
          designation: 'Labourer',
          supplier: '',
        ),
      ),
      isNull,
    );
  });

  test('WorkforceImportRepository automatically creates supervisor accounts and scopes', () async {
    final importer = WorkforceImportRepository(db);

    final res = await importer.commit([
      const WorkforceRow(
        code: 'S1',
        name: 'أحمد مشرف موقع',
        designation: 'Site Supervisor',
        supplier: 'Supp1',
        team: 'فريق أ',
      ),
      const WorkforceRow(
        code: 'H1',
        name: 'خالد مشرف سكن',
        designation: 'Housing Supervisor',
        supplier: 'Supp1',
        campus: 'سكن النرجس',
      ),
      const WorkforceRow(
        code: 'W1',
        name: 'عامر عامل',
        designation: 'Mason',
        supplier: 'Supp1',
      ),
    ]);

    expect(res.added, 3);
    expect(res.accountsCreated, 2);

    final accounts = await auth.accounts();
    final siteSup = accounts.firstWhere(
      (a) => a.role == AuthRole.siteSupervisor,
    );
    final housingSup = accounts.firstWhere(
      (a) => a.role == AuthRole.housingSupervisor,
    );

    expect(siteSup.displayName, 'أحمد مشرف موقع');
    expect(siteSup.teamIds.length, 1);
    expect(siteSup.mustChangePassword, isTrue);

    expect(housingSup.displayName, 'خالد مشرف سكن');
    expect(housingSup.housingIds.length, 1);
    expect(housingSup.mustChangePassword, isTrue);
  });
}
