            throwsA(
              isA<OperationException>().having(
                (e) => e.failure,
                'failure',
                isA<PermissionDenied>(),
              ),
            ),
          );
        }

        expect(
          () => ScopeGuard.guardSiteRecord(
            actor: siteActor,
            scope: scope,
            teamId: 'team-1',
            date: '2026-10-24',
            todayBusinessDate: today,
          ),
          throwsA(
            isA<OperationException>().having(
              (e) => e.failure,
              'failure',
              isA<FutureDate>(),
            ),
          ),
        );

        expect(
          () => ScopeGuard.guardSiteRecord(
            actor: siteActor,
            scope: scope,
            teamId: 'team-1',
            date: '2026-10-15',
            todayBusinessDate: today,
          ),
          throwsA(
            isA<OperationException>().having(
              (e) => e.failure,
              'failure',
              isA<DateOutOfWindow>(),
            ),
          ),
        );
      },
    );
  });
}
