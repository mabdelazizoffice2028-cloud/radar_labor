<file path="test/core/events/event_repository_test.dart">
import 'package:drift/native.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:radar_labor/core/database/app_database.dart';
import 'package:radar_labor/core/database/app_setting_keys.dart';
import 'package:radar_labor/core/events/event_repository.dart';
import 'package:radar_labor/core/status/status_models.dart';

import '../../support/fixed_clock.dart';

const _date = '2026-10-23';
const _yesterday = '2026-10-22';

void main() {
  late AppDatabase database;
  late EventRepository repository;
  final fixedNow = DateTime.utc(2026, 10, 23, 10, 0, 0);

  setUp(() {
    database = AppDatabase(NativeDatabase.memory());
    repository = EventRepository(
      database: database,
      deviceId: 'device-test-01',
      clock: FixedClock(fixedNow),
    );
  });

  tearDown(() => database.close());

  group('EventRepository characterization', () {
    test('append_singleDraft_createsEventAndIncrementsSequence', () async {
      const draft = EventDraft(
        type: EventType.housingCheck,
        action: EventAction.set,
        businessDate: _date,
        housingId: 'house-101',
        userId: 'admin-1',
      );

      final event = await repository.append(draft);

      expect(event.deviceSeq, 1);
      expect(event.type, EventType.housingCheck);
      expect(event.action, EventAction.set);
      expect(event.businessDate, _date);
      expect(event.housingId, 'house-101');
      expect(event.isLate, isFalse);
      expect(event.deviceTimeUtc, fixedNow);

      final seqRow = await (database.select(
        database.settings,
      )..where((s) => s.key.equals(AppSettingKeys.deviceSequence))).getSingle();
      expect(seqRow.value, '1');

      final stored = await repository.readBusinessDate(_date);
      expect(stored, hasLength(1));
      expect(stored.single.eventId, event.eventId);
    });

    test('append_marksLate_whenBusinessDateDiffersFromCurrentCutoff', () async {
      const draft = EventDraft(
        type: EventType.housingCheck,
        action: EventAction.set,
        businessDate: _yesterday,
        housingId: 'house-101',
      );

      final event = await repository.append(draft);
      expect(event.isLate, isTrue);
    });

    test('appendBatch_atomicallyAssignsIncreasingSequence', () async {
      final drafts = [
        const EventDraft(
          type: EventType.housingCheck,
          action: EventAction.set,
          businessDate: _date,
          housingId: 'house-1',
        ),
        const EventDraft(
          type: EventType.housingAbsent,
          action: EventAction.set,
          businessDate: _date,
          employeeUid: 'emp-1',
          housingId: 'house-1',
        ),
        const EventDraft(
          type: EventType.sitePresent,
          action: EventAction.set,
          businessDate: _date,
          employeeUid: 'emp-1',
          teamId: 'team-a',
        ),
      ];

      final events = await repository.appendBatch(drafts);

      expect(events, hasLength(3));
      expect(events.map((e) => e.deviceSeq), [1, 2, 3]);

      final seqRow = await (database.select(
        database.settings,
      )..where((s) => s.key.equals(AppSettingKeys.deviceSequence))).getSingle();
      expect(seqRow.value, '3');
    });

    test('appendBatch_rollsBackEntirelyIfAnyDraftIsInvalid', () async {
      final drafts = [
        const EventDraft(
          type: EventType.housingCheck,
          action: EventAction.set,
          businessDate: _date,
          housingId: 'house-1',
        ),
        const EventDraft(
          type: EventType.sitePresent,
          action: EventAction.set,
          businessDate: _date,
          employeeUid: 'emp-1',
          // Missing teamId!
        ),
      ];

      await expectLater(repository.appendBatch(drafts), throwsArgumentError);

      final stored = await repository.readBusinessDate(_date);
      expect(stored, isEmpty);

      final seqRow =
          await (database.select(database.settings)
                ..where((s) => s.key.equals(AppSettingKeys.deviceSequence)))
              .getSingleOrNull();
      expect(seqRow, isNull);
    });

    test('resumesSequenceFromExistingSettings', () async {
      await database
          .into(database.settings)
          .insert(
            SettingsCompanion.insert(
              key: AppSettingKeys.deviceSequence,
              value: '10',
            ),
          );

      final event = await repository.append(
        const EventDraft(
          type: EventType.housingCheck,
          action: EventAction.set,
          businessDate: _date,
          housingId: 'house-1',
        ),
      );

      expect(event.deviceSeq, 11);
    });

    test('throwsStateErrorIfSequenceSettingIsCorrupted', () async {
      await database
          .into(database.settings)
          .insert(
            SettingsCompanion.insert(
              key: AppSettingKeys.deviceSequence,
              value: 'corrupted_string',
            ),
          );

      await expectLater(
        repository.append(
          const EventDraft(
            type: EventType.housingCheck,
            action: EventAction.set,
            businessDate: _date,
            housingId: 'house-1',
          ),
        ),
        throwsStateError,
      );
    });

    test('validatesDateStringFormat', () async {
      await expectLater(
        repository.append(
          const EventDraft(
            type: EventType.housingCheck,
            action: EventAction.set,
            businessDate: '2026-13-45', // invalid date
            housingId: 'house-1',
          ),
        ),
        throwsArgumentError,
      );
    });

    test('parsesResolutionKindFromPayload', () async {
      final event = await repository.append(
        const EventDraft(
          type: EventType.resolution,
          action: EventAction.set,
          businessDate: _date,
          employeeUid: 'emp-1',
          payload: {'kind': 'housing_error'},
        ),
      );

      expect(event.resolutionKind, ResolutionKind.housingError);
    });

    test('watchBusinessDate_streamsUpdatesForGivenDateOnly', () async {
      final stream = repository.watchBusinessDate(_date);

      final initial = await stream.first;
      expect(initial, isEmpty);

      await repository.append(
        const EventDraft(
          type: EventType.housingCheck,
          action: EventAction.set,
          businessDate: _date,
          housingId: 'house-1',
        ),
      );
      await repository.append(
        const EventDraft(
          type: EventType.housingCheck,
          action: EventAction.set,
          businessDate: _yesterday,
          housingId: 'house-yesterday',
        ),
      );

      final updated = await repository.readBusinessDate(_date);
      expect(updated, hasLength(1));
      expect(updated.single.housingId, 'house-1');

      final yesterdayEvents = await repository.readBusinessDate(_yesterday);
      expect(yesterdayEvents, hasLength(1));
      expect(yesterdayEvents.single.housingId, 'house-yesterday');
    });
  });
}
</file>

<file path="test/core/status/status_engine_characterization_test.dart">
import 'package:flutter_test/flutter_test.dart';
import 'package:radar_labor/core/status/status_engine.dart';
import 'package:radar_labor/core/status/status_models.dart';

const _day = '2026-10-23';
final _now = DateTime.utc(2026, 10, 23, 14, 0, 0);

WorkerProfile _makeWorker({
  String id = 'w-1',
  String code = '101',
  bool active = true,
  String? housingId = 'h-1',
  List<EmploymentPeriod>? periods,
}) => WorkerProfile(
  employeeUid: id,
  code: code,
  fullName: 'Worker $id',
  isActive: active,
  housingId: housingId,
  employmentPeriods: periods ?? [const EmploymentPeriod('2026-01-01')],
);

LocalEvent _makeEvent({
  required EventType type,
  String id = 'ev-1',
  String? workerId = 'w-1',
  EventAction action = EventAction.set,
  String date = _day,
  String? teamId,
  String? housingId,
  int seq = 1,
  DateTime? receivedAt,
  EventDelivery delivery = EventDelivery.pending,
  bool late = false,
  ResolutionKind? resolutionKind,
}) => LocalEvent(
  eventId: id,
  employeeUid: workerId,
  type: type,
  action: action,
  businessDate: date,
  teamId: teamId,
  housingId: housingId,
  deviceSeq: seq,
  receivedAtUtc: receivedAt ?? _now,
  delivery: delivery,
  isLate: late,
  resolutionKind: resolutionKind,
);

void main() {
  group('StatusEngine additional characterization', () {
    const engine = StatusEngine();

    test('multi-worker evaluation retains exact order and isolates states', () {
      final workers = [
        _makeWorker(id: 'w-1', housingId: 'h-1'),
        _makeWorker(id: 'w-2', housingId: 'h-1'),
        _makeWorker(id: 'w-3', housingId: 'h-2'),
      ];

      final events = [
        _makeEvent(
          type: EventType.housingCheck,
          housingId: 'h-1',
          workerId: null,
          id: 'e-chk',
        ),
        _makeEvent(
          type: EventType.housingAbsent,
          housingId: 'h-1',
          workerId: 'w-1',
          id: 'e-abs',
          seq: 2,
        ),
        _makeEvent(
          type: EventType.sitePresent,
          teamId: 't-site',
          workerId: 'w-2',
          id: 'e-pres',
          seq: 3,
        ),
      ];

      final snapshot = engine.evaluate(
        workers: workers,
        events: events,
        businessDate: _day,
        nowUtc: _now,
        slaMinutes: 120,
      );

      expect(snapshot.workers.map((r) => r.worker.employeeUid).toList(), [
        'w-1',
        'w-2',
        'w-3',
      ]);

      expect(snapshot.workers[0].status, WorkerStatus.unknown);
      expect(snapshot.workers[1].status, WorkerStatus.onSite);
      expect(snapshot.workers[2].status, WorkerStatus.notRecorded);
    });

    test(
      'housingCheck only applies to worker if housingId matches exactly',
      () {
        final worker = _makeWorker(id: 'w-1', housingId: 'h-correct');
        final events = [
          _makeEvent(
            type: EventType.housingCheck,
            housingId: 'h-different',
            workerId: null,
          ),
        ];

        final snapshot = engine.evaluate(
          workers: [worker],
          events: events,
          businessDate: _day,
          nowUtc: _now,
          slaMinutes: 120,
        );

        expect(snapshot.workers.single.status, WorkerStatus.notRecorded);
      },
    );

    test(
      'housingAbsent only applies if housingId matches worker assignment',
      () {
        final worker = _makeWorker(id: 'w-1', housingId: 'h-correct');
        final events = [
          _makeEvent(
            type: EventType.housingAbsent,
            housingId: 'h-different',
            workerId: 'w-1',
          ),
        ];

        final snapshot = engine.evaluate(
          workers: [worker],
          events: events,
          businessDate: _day,
          nowUtc: _now,
          slaMinutes: 120,
        );

        expect(snapshot.workers.single.status, WorkerStatus.notRecorded);
      },
    );

    test('worker without housingId ignores housingCheck and housingAbsent', () {
      final worker = _makeWorker(id: 'w-1', housingId: null);
      final events = [
        _makeEvent(
          type: EventType.housingCheck,
          housingId: 'h-1',
          workerId: null,
        ),
        _makeEvent(
          type: EventType.housingAbsent,
          housingId: 'h-1',
          workerId: 'w-1',
          seq: 2,
        ),
      ];

      final snapshot = engine.evaluate(
        workers: [worker],
        events: events,
        businessDate: _day,
        nowUtc: _now,
        slaMinutes: 120,
      );

      expect(snapshot.workers.single.status, WorkerStatus.notRecorded);
    });

    test('employment periods boundaries characterization', () {
      final pastOnly = _makeWorker(
        id: 'w-past',
        periods: [const EmploymentPeriod('2026-01-01', endDate: '2026-10-22')],
      );
      final futureOnly = _makeWorker(
        id: 'w-future',
        periods: [const EmploymentPeriod('2026-10-24')],
      );
      final spanning = _makeWorker(
        id: 'w-active',
        periods: [const EmploymentPeriod('2026-10-01', endDate: '2026-10-31')],
      );

      final snapshot = engine.evaluate(
        workers: [pastOnly, futureOnly, spanning],
        events: const [],
        businessDate: _day,
        nowUtc: _now,
        slaMinutes: 120,
      );

      expect(snapshot.workers[0].isEligible, isFalse);
      expect(snapshot.workers[1].isEligible, isFalse);
      expect(snapshot.workers[2].isEligible, isTrue);
    });

    test('sla with zero minutes breaches immediately if time elapsed', () {
      final checkAt = _now.subtract(const Duration(seconds: 1));
      final worker = _makeWorker(id: 'w-1', housingId: 'h-1');
      final events = [
        _makeEvent(
          type: EventType.housingCheck,
          housingId: 'h-1',
          receivedAt: checkAt,
          workerId: null,
        ),
        _makeEvent(
          type: EventType.housingAbsent,
          housingId: 'h-1',
          workerId: 'w-1',
          seq: 2,
        ),
      ];

      final snapshot = engine.evaluate(
        workers: [worker],
        events: events,
        businessDate: _day,
        nowUtc: _now,
        slaMinutes: 0,
      );

      expect(snapshot.workers.single.status, WorkerStatus.unknown);
      expect(snapshot.workers.single.isSlaBreached, isTrue);
    });

    test('resolutionKind other also clears housingSiteConflict flag', () {
      final worker = _makeWorker(id: 'w-1', housingId: 'h-1');
      final events = [
        _makeEvent(
          type: EventType.housingAbsent,
          housingId: 'h-1',
          workerId: 'w-1',
          id: 'e-1',
          seq: 1,
        ),
        _makeEvent(
          type: EventType.sitePresent,
          teamId: 'team-a',
          workerId: 'w-1',
          id: 'e-2',
          seq: 2,
        ),
        _makeEvent(
          type: EventType.resolution,
          workerId: 'w-1',
          id: 'e-3',
          seq: 3,
          resolutionKind: ResolutionKind.siteError,
        ),
      ];

      final snapshot = engine.evaluate(
        workers: [worker],
        events: events,
        businessDate: _day,
        nowUtc: _now,
        slaMinutes: 120,
      );

      expect(snapshot.workers.single.status, WorkerStatus.onSite);
      expect(
        snapshot.workers.single.flags,
        isNot(contains(StatusFlag.housingSiteConflict)),
      );
    });
  });
}
</file>

<file path="test/core/status/status_engine_test.dart">
import 'package:flutter_test/flutter_test.dart';
import 'package:radar_labor/core/status/status_engine.dart';
import 'package:radar_labor/core/status/status_models.dart';

const _day = '2026-10-23';
final _now = DateTime.utc(2026, 10, 23, 12);

WorkerProfile _worker({
  String id = 'worker-1',
  bool active = true,
  List<EmploymentPeriod>? periods,
  String? housingId = 'house-1',
}) => WorkerProfile(
  employeeUid: id,
  code: '001',
  fullName: 'Worker',
  isActive: active,
  housingId: housingId,
  employmentPeriods: periods ?? [const EmploymentPeriod('2026-01-01')],
);

LocalEvent _event(
  EventType type, {
  String id = 'e1',
  String workerId = 'worker-1',
  EventAction action = EventAction.set,
  String date = _day,
  String? teamId,
  String? housingId,
  int seq = 1,
  DateTime? receivedAt,
  EventDelivery delivery = EventDelivery.pending,
  bool late = false,
  ResolutionKind? resolutionKind,
}) => LocalEvent(
  eventId: id,
  employeeUid: workerId,
  type: type,
  action: action,
  businessDate: date,
  teamId: teamId,
  housingId: housingId,
  deviceSeq: seq,
  receivedAtUtc: receivedAt ?? _now,
  delivery: delivery,
  isLate: late,
  resolutionKind: resolutionKind,
);

WorkerStatusResult _evaluate(
  List<LocalEvent> events, {
  WorkerProfile? worker,
  String date = _day,
  DateTime? now,
  int slaMinutes = 120,
}) => StatusEngine()
    .evaluate(
      workers: [worker ?? _worker()],
      events: events,
      businessDate: date,
      nowUtc: now ?? _now,
      slaMinutes: slaMinutes,
    )
    .workers
    .single;

void main() {
  group('worker status rules', () {
    test('noEvents_isNotRecorded', () {
      expect(_evaluate([]).status, WorkerStatus.notRecorded);
    });

    test('sitePresent_isOnSite', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a'),
      ]);
      expect(result.status, WorkerStatus.onSite);
      expect(result.teamId, 'team-a');
    });

    test('housingCheck_isHousingOnly', () {
      expect(
        _evaluate([_event(EventType.housingCheck, housingId: 'house-1')])
            .status,
        WorkerStatus.housingOnly,
      );
    });

    test('housingAbsent_isUnknown', () {
      expect(
        _evaluate([_event(EventType.housingAbsent, housingId: 'house-1')])
            .status,
        WorkerStatus.unknown,
      );
    });

    test('housingAbsentWithJustification_isJustified', () {
      expect(
        _evaluate([
          _event(EventType.housingAbsent, housingId: 'house-1'),
          _event(EventType.justification, id: 'e2', seq: 2),
        ]).status,
        WorkerStatus.justified,
      );
    });

    test('sitePresentWinsAndFlagsHousingConflict', () {
      final result = _evaluate([
        _event(EventType.housingAbsent, housingId: 'house-1'),
        _event(EventType.sitePresent, id: 'e2', teamId: 'team-a', seq: 2),
      ]);
      expect(result.status, WorkerStatus.onSite);
      expect(result.flags, contains(StatusFlag.housingSiteConflict));
    });

    test('multipleActiveTeams_flagContradictionAndChooseLatest', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a'),
        _event(
          EventType.sitePresent,
          id: 'e2',
          teamId: 'team-b',
          seq: 2,
          receivedAt: _now.add(const Duration(minutes: 1)),
        ),
      ]);
      expect(result.status, WorkerStatus.onSite);
      expect(result.teamId, 'team-b');
      expect(result.flags, contains(StatusFlag.multipleSiteTeams));
    });

    test('activeResolution_clearsConflictFlagWithoutChangingStatus', () {
      final result = _evaluate([
        _event(EventType.housingAbsent, housingId: 'house-1'),
        _event(EventType.sitePresent, id: 'e2', teamId: 'team-a', seq: 2),
        _event(
          EventType.resolution,
          id: 'e3',
          seq: 3,
          resolutionKind: ResolutionKind.housingError,
        ),
      ]);
      expect(result.status, WorkerStatus.onSite);
      expect(result.flags, isNot(contains(StatusFlag.housingSiteConflict)));
    });

    test('movedDuringDayResolution_clearsMultipleTeamFlag', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a'),
        _event(EventType.sitePresent, id: 'e2', teamId: 'team-b', seq: 2),
        _event(
          EventType.resolution,
          id: 'e3',
          seq: 3,
          resolutionKind: ResolutionKind.movedDuringDay,
        ),
      ]);
      expect(result.status, WorkerStatus.onSite);
      expect(result.flags, isNot(contains(StatusFlag.multipleSiteTeams)));
    });

    test('clearedResolution_restoresConflictFlag', () {
      final result = _evaluate([
        _event(EventType.housingAbsent, housingId: 'house-1'),
        _event(EventType.sitePresent, id: 'e2', teamId: 'team-a', seq: 2),
        _event(
          EventType.resolution,
          id: 'e3',
          seq: 3,
          resolutionKind: ResolutionKind.housingError,
        ),
        _event(
          EventType.resolution,
          id: 'e4',
          action: EventAction.clear,
          seq: 4,
          resolutionKind: ResolutionKind.housingError,
        ),
      ]);
      expect(result.flags, contains(StatusFlag.housingSiteConflict));
    });

    test('clearedSitePresence_doesNotRemainOnSite', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a'),
        _event(
          EventType.sitePresent,
          id: 'e2',
          action: EventAction.clear,
          teamId: 'team-a',
          seq: 2,
        ),
      ]);
      expect(result.status, WorkerStatus.notRecorded);
    });

    test('clearedAbsence_fallsBackToHousingCheck', () {
      expect(
        _evaluate([
          _event(EventType.housingCheck, housingId: 'house-1'),
          _event(EventType.housingAbsent, housingId: 'house-1'),
          _event(
            EventType.housingAbsent,
            id: 'e3',
            action: EventAction.clear,
            housingId: 'house-1',
            seq: 3,
          ),
        ]).status,
        WorkerStatus.housingOnly,
      );
    });

    test('clearedHousingCheck_doesNotCountAsHousingOnly', () {
      expect(
        _evaluate([
          _event(EventType.housingCheck, housingId: 'house-1'),
          _event(
            EventType.housingCheck,
            id: 'e2',
            action: EventAction.clear,
            housingId: 'house-1',
            seq: 2,
          ),
        ]).status,
        WorkerStatus.notRecorded,
      );
    });

    test('clearedJustification_returnsToUnknown', () {
      expect(
        _evaluate([
          _event(EventType.housingAbsent, housingId: 'house-1'),
          _event(EventType.justification, id: 'e2', seq: 2),
          _event(
            EventType.justification,
            id: 'e3',
            action: EventAction.clear,
            seq: 3,
          ),
        ]).status,
        WorkerStatus.unknown,
      );
    });

    test('newerSetReactivatesAKeyAfterClear', () {
      expect(
        _evaluate([
          _event(EventType.sitePresent, teamId: 'team-a'),
          _event(
            EventType.sitePresent,
            id: 'e2',
            action: EventAction.clear,
            teamId: 'team-a',
            seq: 2,
          ),
          _event(EventType.sitePresent, id: 'e3', teamId: 'team-a', seq: 3),
        ]).status,
        WorkerStatus.onSite,
      );
    });

    test('newerClearWinsOverPriorSet', () {
      expect(
        _evaluate([
          _event(EventType.sitePresent, teamId: 'team-a'),
          _event(
            EventType.sitePresent,
            id: 'e2',
            action: EventAction.clear,
            teamId: 'team-a',
            seq: 2,
          ),
        ]).status,
        WorkerStatus.notRecorded,
      );
    });

    test('receivedAtOrdersBeforeSequence', () {
      final later = _event(
        EventType.sitePresent,
        id: 'later',
        teamId: 'team-b',
        seq: 1,
        receivedAt: _now.add(const Duration(minutes: 2)),
        delivery: EventDelivery.acked,
      );
      final earlier = _event(
        EventType.sitePresent,
        id: 'earlier',
        teamId: 'team-a',
        seq: 99,
        receivedAt: _now,
        delivery: EventDelivery.acked,
      );
      expect(_evaluate([later, earlier]).teamId, 'team-b');
    });

    test('deviceSequenceBreaksReceivedAtTie', () {
      expect(
        _evaluate([
          _event(EventType.sitePresent, teamId: 'team-a', seq: 1),
          _event(EventType.sitePresent, id: 'e2', teamId: 'team-b', seq: 2),
        ]).teamId,
        'team-b',
      );
    });

    test('localPendingEventOrdersAfterAcknowledgedEvent', () {
      expect(
        _evaluate([
          _event(
            EventType.sitePresent,
            teamId: 'team-a',
            seq: 99,
            delivery: EventDelivery.acked,
          ),
          _event(
            EventType.sitePresent,
            id: 'e2',
            teamId: 'team-b',
            seq: 1,
            delivery: EventDelivery.pending,
          ),
        ]).teamId,
        'team-b',
      );
    });

    test('otherHousingCheck_doesNotApplyToWorker', () {
      expect(
        _evaluate([_event(EventType.housingCheck, housingId: 'house-2')])
            .status,
        WorkerStatus.notRecorded,
      );
    });

    test('absenceForOtherHousing_doesNotApplyToWorker', () {
      expect(
        _evaluate([_event(EventType.housingAbsent, housingId: 'house-2')])
            .status,
        WorkerStatus.notRecorded,
      );
    });

    test('slaBreach_requiresUnknownAndElapsedBeyondLimit', () {
      final checkedAt = _now.subtract(const Duration(minutes: 121));
      final result = _evaluate([
        _event(
          EventType.housingCheck,
          housingId: 'house-1',
          receivedAt: checkedAt,
        ),
        _event(EventType.housingAbsent, housingId: 'house-1', id: 'e2'),
      ], now: _now);
      expect(result.status, WorkerStatus.unknown);
      expect(result.isSlaBreached, isTrue);
    });

    test('slaAtExactLimit_isNotBreached', () {
      final result = _evaluate([
        _event(
          EventType.housingCheck,
          housingId: 'house-1',
          receivedAt: _now.subtract(const Duration(minutes: 120)),
        ),
        _event(EventType.housingAbsent, housingId: 'house-1', id: 'e2'),
      ]);
      expect(result.isSlaBreached, isFalse);
    });

    test('futureHousingCheck_doesNotBreachSla', () {
      final result = _evaluate([
        _event(
          EventType.housingCheck,
          housingId: 'house-1',
          receivedAt: _now.add(const Duration(minutes: 5)),
        ),
        _event(EventType.housingAbsent, housingId: 'house-1', id: 'e2'),
      ]);
      expect(result.isSlaBreached, isFalse);
    });

    test('unknownWithoutHousingCheck_hasNoSlaTimer', () {
      final result = _evaluate([
        _event(EventType.housingAbsent, housingId: 'house-1'),
      ]);
      expect(result.status, WorkerStatus.unknown);
      expect(result.isSlaBreached, isFalse);
    });

    test('inactiveRosterEntry_isExcludedFromCounts', () {
      final result = _evaluate([], worker: _worker(active: false));
      expect(result.isEligible, isFalse);
      expect(result.status, WorkerStatus.notRecorded);
    });

    test('inactiveWorkerWithEvent_isFlagged', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a'),
      ], worker: _worker(active: false));
      expect(result.flags, contains(StatusFlag.inactiveWorkerEvent));
      expect(result.isEligible, isFalse);
    });

    test('outsideEmploymentPeriod_isExcluded', () {
      final result = _evaluate(
        [],
        worker: _worker(periods: [const EmploymentPeriod('2026-10-24')]),
      );
      expect(result.isEligible, isFalse);
    });

    test('eventBeforeEmployment_isFlagged', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a'),
      ], worker: _worker(periods: [const EmploymentPeriod('2026-10-24')]));
      expect(result.flags, contains(StatusFlag.eventOutsideEmployment));
    });

    test('secondEmploymentPeriod_isEligible', () {
      final result = _evaluate(
        [],
        worker: _worker(
          periods: [
            const EmploymentPeriod('2026-01-01', endDate: '2026-06-30'),
            const EmploymentPeriod('2026-10-01'),
          ],
        ),
      );
      expect(result.isEligible, isTrue);
    });

    test('otherEmployeeEvents_areIgnored', () {
      expect(
        _evaluate([
          _event(EventType.sitePresent, workerId: 'worker-2', teamId: 'team-a'),
        ]).status,
        WorkerStatus.notRecorded,
      );
    });

    test('otherBusinessDateEvents_areIgnored', () {
      expect(
        _evaluate([
          _event(EventType.sitePresent, date: '2026-10-22', teamId: 'team-a'),
        ]).status,
        WorkerStatus.notRecorded,
      );
    });

    test('lateEvent_isFlagged', () {
      final result = _evaluate([
        _event(EventType.sitePresent, teamId: 'team-a', late: true),
      ]);
      expect(result.flags, contains(StatusFlag.lateEvent));
    });

    test('rejectedEvent_isFlaggedAndNotApplied', () {
      final result = _evaluate([
        _event(
          EventType.sitePresent,
          teamId: 'team-a',
          delivery: EventDelivery.rejected,
        ),
      ]);
      expect(result.status, WorkerStatus.notRecorded);
      expect(result.flags, contains(StatusFlag.rejectedEvent));
    });

    test('siteSubmissionWithoutEmployee_doesNotCreateWorkerStatus', () {
      final result = _evaluate([
        LocalEvent(
          eventId: 'submit',
          type: EventType.siteSubmitted,
          action: EventAction.set,
          businessDate: _day,
          teamId: 'team-a',
          deviceSeq: 1,
          receivedAtUtc: _now,
        ),
      ]);
      expect(result.status, WorkerStatus.notRecorded);
    });

    test('clearedStatusEventForUnknownDate_doesNotLeakIntoCurrentDate', () {
      expect(
        _evaluate([
          _event(EventType.sitePresent, date: '2026-10-22', teamId: 'team-a'),
          _event(
            EventType.sitePresent,
            id: 'clear',
            action: EventAction.clear,
            date: _day,
            teamId: 'team-a',
          ),
        ]).status,
        WorkerStatus.notRecorded,
      );
    });

    test('resultsRemainInRosterOrder', () {
      final snapshot = StatusEngine().evaluate(
        workers: [
          _worker(id: 'second'),
          _worker(id: 'first'),
        ],
        events: const [],
        businessDate: _day,
        nowUtc: _now,
        slaMinutes: 120,
      );
      expect(snapshot.workers.map((result) => result.worker.employeeUid), [
        'second',
        'first',
      ]);
    });

    test('businessDateMustUseIsoFormat', () {
      expect(
        () => StatusEngine().evaluate(
          workers: const [],
          events: const [],
          businessDate: '23/10/2026',
          nowUtc: _now,
          slaMinutes: 120,
        ),
        throwsArgumentError,
      );
    });
