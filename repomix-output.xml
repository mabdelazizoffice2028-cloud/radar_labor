<file path="lib/features/operations/domain/attendance_ledger.dart">
import 'package:radar_labor/core/status/status_models.dart';

/// Composite key identifying an event stream slot within a single business date (PRD §6.1).
final class LedgerKey {
  const LedgerKey({
    required this.type,
    this.employeeUid,
    this.teamId,
    this.housingId,
  });

  final EventType type;
  final String? employeeUid;
  final String? teamId;
  final String? housingId;

  factory LedgerKey.fromEvent(LocalEvent event) => LedgerKey(
    type: event.type,
    employeeUid: event.employeeUid,
    teamId: event.teamId,
    housingId: event.housingId,
  );

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is LedgerKey &&
          type == other.type &&
          employeeUid == other.employeeUid &&
          teamId == other.teamId &&
          housingId == other.housingId;

  @override
  int get hashCode => Object.hash(type, employeeUid, teamId, housingId);
}

/// Pure single-device effective-state calculator over immutable [LocalEvent]s (PRD §6.1).
final class AttendanceLedger {
  AttendanceLedger(Iterable<LocalEvent> dayEvents) {
    for (final event in dayEvents) {
      if (event.delivery == EventDelivery.rejected) continue;
      final key = LedgerKey.fromEvent(event);
      final prior = _latestByKey[key];
      if (prior == null || event.deviceSeq > prior.deviceSeq) {
        _latestByKey[key] = event;
      }
    }
  }

  final Map<LedgerKey, LocalEvent> _latestByKey = <LedgerKey, LocalEvent>{};

  /// Returns the latest event (set or clear) for [key], or null if never touched.
  LocalEvent? latestEventFor(LedgerKey key) => _latestByKey[key];

  /// Returns the latest active (`EventAction.set`) event for [key], or null if cleared/absent.
  LocalEvent? activeEventFor(LedgerKey key) {
    final latest = _latestByKey[key];
    return latest != null && latest.action == EventAction.set ? latest : null;
  }

  /// Whether [teamId] has an active `siteSubmitted` event for the day.
  bool isSiteSubmitted(String teamId) =>
      activeEventFor(
        LedgerKey(type: EventType.siteSubmitted, teamId: teamId),
      ) !=
      null;

  /// Latest active `siteSubmitted` event for [teamId], if any.
  LocalEvent? siteSubmissionEvent(String teamId) =>
      activeEventFor(LedgerKey(type: EventType.siteSubmitted, teamId: teamId));

  /// Whether [housingId] has an active `housingCheck` event for the day.
  bool isHousingChecked(String housingId) =>
      activeEventFor(
        LedgerKey(type: EventType.housingCheck, housingId: housingId),
      ) !=
      null;

  /// Latest active `housingCheck` event for [housingId], if any.
  LocalEvent? housingCheckEvent(String housingId) => activeEventFor(
    LedgerKey(type: EventType.housingCheck, housingId: housingId),
  );

  /// Active present worker IDs for [teamId].
  Set<String> presentWorkerIdsForTeam(String teamId) {
    final result = <String>{};
    for (final entry in _latestByKey.entries) {
      if (entry.key.type == EventType.sitePresent &&
          entry.key.teamId == teamId &&
          entry.key.employeeUid != null &&
          entry.value.action == EventAction.set) {
        result.add(entry.key.employeeUid!);
      }
    }
    return Set.unmodifiable(result);
  }

  /// Active absent worker IDs for [housingId].
  Set<String> absentWorkerIdsForHousing(String housingId) {
    final result = <String>{};
    for (final entry in _latestByKey.entries) {
      if (entry.key.type == EventType.housingAbsent &&
          entry.key.housingId == housingId &&
          entry.key.employeeUid != null &&
          entry.value.action == EventAction.set) {
        result.add(entry.key.employeeUid!);
      }
    }
    return Set.unmodifiable(result);
  }

  /// Active `sitePresent` events for [employeeUid] in teams other than [excludeTeamId].
  List<LocalEvent> otherTeamPresencesForWorker({
    required String employeeUid,
    required String excludeTeamId,
  }) {
    final events = <LocalEvent>[];
    for (final entry in _latestByKey.entries) {
      if (entry.key.type == EventType.sitePresent &&
          entry.key.employeeUid == employeeUid &&
          entry.key.teamId != null &&
          entry.key.teamId != excludeTeamId &&
          entry.value.action == EventAction.set) {
        events.add(entry.value);
      }
    }
    events.sort((a, b) => a.deviceSeq.compareTo(b.deviceSeq));
    return List.unmodifiable(events);
  }

  /// Returns the latest event touching [teamId] (`siteSubmitted` or `sitePresent`) to identify the last actor.
  LocalEvent? lastTeamRecordingEvent(String teamId) {
    LocalEvent? latest;
    for (final entry in _latestByKey.entries) {
      if (entry.key.teamId == teamId &&
          (entry.key.type == EventType.siteSubmitted ||
              entry.key.type == EventType.sitePresent)) {
        if (latest == null || entry.value.deviceSeq > latest.deviceSeq) {
          latest = entry.value;
        }
      }
    }
    return latest;
  }

  /// Returns the latest event touching [housingId] (`housingCheck` or `housingAbsent`).
  LocalEvent? lastHousingRecordingEvent(String housingId) {
    LocalEvent? latest;
    for (final entry in _latestByKey.entries) {
      if (entry.key.housingId == housingId &&
          (entry.key.type == EventType.housingCheck ||
              entry.key.type == EventType.housingAbsent)) {
        if (latest == null || entry.value.deviceSeq > latest.deviceSeq) {
          latest = entry.value;
        }
      }
    }
    return latest;
  }
}
</file>

<file path="lib/features/operations/domain/conflict_detector.dart">
import 'package:radar_labor/core/l10n/name_collation.dart';
import 'package:radar_labor/features/operations/domain/attendance_ledger.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';

/// Supervisor's resolution choice for a same-day local attendance conflict (PRD §9.2).
enum ConflictResolutionChoice {
  transferDuringDay,
  removeFromOtherTeam,
  skipWorker,
}

/// Represents a same-day, same-device attendance conflict for a worker (PRD §9.1).
final class AttendanceConflict {
  const AttendanceConflict({
    required this.worker,
    required this.otherTeamId,
    required this.otherTeamNameAr,
    this.otherTeamNameEn,
    required this.recordedAtUtc,
    this.recordedByUserId,
  });

  final WorkerOption worker;
  final String otherTeamId;
  final String otherTeamNameAr;
  final String? otherTeamNameEn;
  final DateTime recordedAtUtc;
  final String? recordedByUserId;

  String otherTeamDisplayName({required bool arabic}) =>
      arabic ? otherTeamNameAr : (otherTeamNameEn ?? otherTeamNameAr);
}

/// Pure detector for same-day, same-device cross-team attendance conflicts (PRD §9.1).
abstract final class ConflictDetector {
  static List<AttendanceConflict> detect({
    required AttendanceLedger ledger,
    required String currentTeamId,
    required Set<String> selectedWorkerIds,
    required Map<String, WorkerOption> workersById,
    required Map<String, EntityOption> teamsById,
    required bool arabic,
  }) {
    final conflicts = <AttendanceConflict>[];
    for (final workerId in selectedWorkerIds) {
      final worker = workersById[workerId];
      if (worker == null) continue;
      final otherEvents = ledger.otherTeamPresencesForWorker(
        employeeUid: workerId,
        excludeTeamId: currentTeamId,
      );
      if (otherEvents.isEmpty) continue;
      // Use the latest active presence in another team
      final latestOther = otherEvents.last;
      final otherTeamId = latestOther.teamId!;
      final otherTeam = teamsById[otherTeamId];
      conflicts.add(
        AttendanceConflict(
          worker: worker,
          otherTeamId: otherTeamId,
          otherTeamNameAr: otherTeam?.nameAr ?? otherTeamId,
          otherTeamNameEn: otherTeam?.nameEn,
          recordedAtUtc:
              latestOther.deviceTimeUtc ??
              DateTime.fromMillisecondsSinceEpoch(0, isUtc: true),
          recordedByUserId: latestOther.userId,
        ),
      );
    }

    conflicts.sort(
      (a, b) => NameCollation.compareWorkers(
        nameA: a.worker.displayName(arabic: arabic),
        codeA: a.worker.code,
        idA: a.worker.id,
        nameB: b.worker.displayName(arabic: arabic),
        codeB: b.worker.code,
        idB: b.worker.id,
      ),
    );
    return List.unmodifiable(conflicts);
  }
}
</file>

<file path="lib/features/operations/domain/history_builder.dart">
import 'package:radar_labor/core/auth/scope_snapshot.dart';
import 'package:radar_labor/core/constants/operations_constants.dart';
import 'package:radar_labor/core/l10n/attendance_message_strings.dart';
import 'package:radar_labor/core/l10n/history_strings.dart';
import 'package:radar_labor/core/l10n/name_collation.dart';
import 'package:radar_labor/core/status/status_models.dart';
import 'package:radar_labor/features/operations/domain/attendance_ledger.dart';
import 'package:radar_labor/features/operations/domain/history_models.dart';
import 'package:radar_labor/features/operations/domain/operations_models.dart';
import 'package:radar_labor/features/operations/domain/whatsapp_template_engine.dart';

/// Pure domain builder for supervisor and admin history views (PRD §11.1, §11.3).
abstract final class HistoryBuilder {
  static HistoryPage build({
    required Iterable<LocalEvent> rangeEvents,
    required ActorContext actor,
    required ScopeSnapshot scope,
    required Map<String, EntityOption> teamsById,
    required Map<String, EntityOption> housingsById,
    required Map<String, WorkerOption> workersById,
    required Map<String, String> userNamesById,
    required String todayBusinessDate,
    required String fromDate,
    required String toDate,
    required bool hasMore,
    required bool arabic,
  }) {
    final byDate = <String, List<LocalEvent>>{};
    for (final event in rangeEvents) {
      if (event.delivery == EventDelivery.rejected) continue;
      byDate.putIfAbsent(event.businessDate, () => <LocalEvent>[]).add(event);
    }

    final sortedDates = byDate.keys.toList()..sort((a, b) => b.compareTo(a));
    final strings = AttendanceMessageStrings.fromLanguage(arabic: arabic);
    final cards = <HistoryDayCard>[];

    final viewAll = actor.capabilities.canViewAllHistory;
    final includeSite = viewAll || actor.capabilities.canRecordSite;
    final includeHousing = viewAll || actor.capabilities.canRecordHousing;

    for (final date in sortedDates) {
      final ledger = AttendanceLedger(byDate[date]!);

      if (includeSite) {
        final teamIds = viewAll
            ? teamsById.keys.toList()
            : scope.teamIds.where(teamsById.containsKey).toList();
        teamIds.sort((a, b) {
          final ta = teamsById[a]!;
          final tb = teamsById[b]!;
          return NameCollation.sortKey(ta.displayName(arabic: arabic))
              .compareTo(NameCollation.sortKey(tb.displayName(arabic: arabic)));
        });

        for (final teamId in teamIds) {
          if (!ledger.isSiteSubmitted(teamId)) continue;
          final team = teamsById[teamId]!;
          final presentIds = ledger.presentWorkerIdsForTeam(teamId);
          final workers = _sortedWorkers(presentIds, workersById, arabic);
          final lastEvent = ledger.lastTeamRecordingEvent(teamId);
          final actorId = lastEvent?.userId;
          final actorName = actorId == null ? null : userNamesById[actorId];
          final canEdit =
              actor.capabilities.canRecordSite &&
              actor.capabilities.canEditPastDays &&
              scope.allowsTeam(teamId) &&
              _isWithinEditWindow(date, todayBusinessDate);

          final msg = WhatsappTemplateEngine.format(
            kind: WhatsappMessageKind.site,
            date: date,
            entityName: team.displayName(arabic: arabic),
            workers: [
              for (final w in workers)
                WhatsappWorkerItem(
                  code: w.code,
                  name: w.displayName(arabic: arabic),
                ),
            ],
            arabic: arabic,
            strings: strings,
          );

          cards.add(
            HistoryDayCard(
              kind: HistoryEntryKind.site,
              entity: team,
              businessDate: date,
              workers: workers,
              recordedAtUtc: lastEvent?.deviceTimeUtc,
              lastActorUserId: actorId,
              lastActorName: actorName,
              canEdit: canEdit,
              whatsappMessage: msg,
            ),
          );
        }
      }

      if (includeHousing) {
        final housingIds = viewAll
            ? housingsById.keys.toList()
            : scope.housingIds.where(housingsById.containsKey).toList();
        housingIds.sort((a, b) {
          final ha = housingsById[a]!;
          final hb = housingsById[b]!;
          return NameCollation.sortKey(ha.displayName(arabic: arabic))
              .compareTo(NameCollation.sortKey(hb.displayName(arabic: arabic)));
        });

        for (final housingId in housingIds) {
          if (!ledger.isHousingChecked(housingId)) continue;
          final housing = housingsById[housingId]!;
          final absentIds = ledger.absentWorkerIdsForHousing(housingId);
          final workers = _sortedWorkers(absentIds, workersById, arabic);
          final lastEvent = ledger.lastHousingRecordingEvent(housingId);
          final actorId = lastEvent?.userId;
          final actorName = actorId == null ? null : userNamesById[actorId];

          final msg = WhatsappTemplateEngine.format(
            kind: WhatsappMessageKind.housing,
            date: date,
            entityName: housing.displayName(arabic: arabic),
            workers: [
              for (final w in workers)
                WhatsappWorkerItem(
                  code: w.code,
                  name: w.displayName(arabic: arabic),
                ),
            ],
            arabic: arabic,
            strings: strings,
          );

          cards.add(
            HistoryDayCard(
              kind: HistoryEntryKind.housing,
              entity: housing,
              businessDate: date,
              workers: workers,
              recordedAtUtc: lastEvent?.deviceTimeUtc,
              lastActorUserId: actorId,
              lastActorName: actorName,
              canEdit: false,
              whatsappMessage: msg,
            ),
          );
        }
      }
    }

    final bySite = <String, List<HistoryDayCard>>{};
    final bySupervisor = <String, List<HistoryDayCard>>{};
    for (final card in cards) {
      final siteKey = card.entity.displayName(arabic: arabic);
      bySite.putIfAbsent(siteKey, () => <HistoryDayCard>[]).add(card);

      final supKey =
          card.lastActorName ?? HistoryStrings.historyUnknownActor(arabic);
      bySupervisor.putIfAbsent(supKey, () => <HistoryDayCard>[]).add(card);
    }

    return HistoryPage(
      cards: List.unmodifiable(cards),
      fromDate: fromDate,
      toDate: toDate,
      hasMore: hasMore,
      bySite: Map.unmodifiable(bySite),
      bySupervisor: Map.unmodifiable(bySupervisor),
    );
  }

  static List<WorkerOption> _sortedWorkers(
    Set<String> ids,
    Map<String, WorkerOption> workersById,
    bool arabic,
  ) {
    final list = <WorkerOption>[
      for (final id in ids)
        if (workersById[id] != null) workersById[id]!,
    ];
    list.sort(
      (a, b) => NameCollation.compareWorkers(
        nameA: a.displayName(arabic: arabic),
        codeA: a.code,
        idA: a.id,
        nameB: b.displayName(arabic: arabic),
        codeB: b.code,
        idB: b.id,
      ),
    );
    return List.unmodifiable(list);
  }

  static bool _isWithinEditWindow(String date, String today) {
    final target = DateTime.tryParse(date);
    final current = DateTime.tryParse(today);
    if (target == null || current == null) return false;
    final diff = current.difference(target).inDays;
    return diff >= 0 && diff <= OperationsConstants.maxBackdateDays;
  }
}
</file>

