<file path="lib/features/operations/presentation/widgets/attendance_row_tile.dart">
import 'package:material_ui/material_ui.dart';
import 'package:radar_labor/core/l10n/operations_strings.dart';
import 'package:radar_labor/core/ui/app_tokens.dart';
import 'package:radar_labor/features/operations/domain/site_attendance_store.dart';

/// Accessible 64dp worker row tile for smart daily check-in (PRD §8.1, §17.1).
class AttendanceRowTile extends StatelessWidget {
  const AttendanceRowTile({
    required this.row,
    required this.arabic,
    required this.onToggle,
    this.onRemoveGuest,
    super.key,
  });

  final AttendanceRow row;
  final bool arabic;
  final VoidCallback onToggle;
  final VoidCallback? onRemoveGuest;

  @override
  Widget build(BuildContext context) {
    final name = row.worker.displayName(arabic: arabic);
    final statusText = row.isPresent
        ? OperationsStrings.presentLabel(arabic)
        : OperationsStrings.notPresentLabel(arabic);
    final badgeText = _badgeText();
    final bgColor = row.isPresent
        ? AppTokens.statusOnSiteSoft
        : AppTokens.surface;
    final borderColor = row.isPresent
        ? AppTokens.statusOnSite
        : AppTokens.outline;

    return Semantics(
      checked: row.isPresent,
      enabled: !row.isLocked,
      label: '$name, $statusText${badgeText == null ? '' : ', $badgeText'}',
      child: Padding(
        padding: const EdgeInsets.only(bottom: AppTokens.space8),
        child: Material(
          color: bgColor,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(AppTokens.radius12),
            side: BorderSide(color: borderColor),
          ),
          child: InkWell(
            borderRadius: BorderRadius.circular(AppTokens.radius12),
            onTap: row.isLocked ? null : onToggle,
            child: ConstrainedBox(
              constraints: const BoxConstraints(
                minHeight: AppTokens.minRowHeight,
              ),
              child: Padding(
                padding: const EdgeInsets.symmetric(
                  horizontal: AppTokens.space12,
                  vertical: AppTokens.space8,
                ),
                child: Row(
                  children: [
                    Icon(
                      row.isLocked
                          ? Icons.lock_outline
                          : (row.isPresent
                                ? Icons.check_circle
                                : Icons.radio_button_unchecked),
                      color: row.isPresent
                          ? AppTokens.statusOnSite
                          : AppTokens.statusNotRecorded,
                    ),
                    const SizedBox(width: AppTokens.space12),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Text(
                            name,
                            style: Theme.of(context).textTheme.bodyLarge
                                ?.copyWith(fontWeight: FontWeight.w600),
                          ),
                          const SizedBox(height: 2),
                          Wrap(
                            spacing: AppTokens.space8,
                            crossAxisAlignment: WrapCrossAlignment.center,
                            children: [
                              Text(
                                row.worker.code,
                                style: Theme.of(context).textTheme.bodySmall,
                              ),
                              if (badgeText != null)
                                Container(
                                  padding: const EdgeInsets.symmetric(
                                    horizontal: AppTokens.space8,
                                    vertical: 2,
                                  ),
                                  decoration: BoxDecoration(
                                    color: AppTokens.background,
                                    borderRadius: BorderRadius.circular(
                                      AppTokens.radiusChip,
                                    ),
                                    border: Border.all(
                                      color: AppTokens.outline,
                                    ),
                                  ),
                                  child: Text(
                                    badgeText,
                                    style: Theme.of(context)
                                        .textTheme
                                        .labelSmall,
                                  ),
                                ),
                            ],
                          ),
                        ],
                      ),
                    ),
                    const SizedBox(width: AppTokens.space8),
                    Text(
                      statusText,
                      style: Theme.of(context).textTheme.labelMedium?.copyWith(
                        color: row.isPresent
                            ? AppTokens.statusOnSite
                            : AppTokens.textSecondary,
                        fontWeight: FontWeight.w700,
                      ),
                    ),
                    if (row.isGuest && onRemoveGuest != null) ...[
                      const SizedBox(width: AppTokens.space4),
                      IconButton(
                        tooltip: OperationsStrings.removeGuest(arabic),
                        constraints: const BoxConstraints(
                          minWidth: AppTokens.minTouchTarget,
                          minHeight: AppTokens.minTouchTarget,
                        ),
                        onPressed: onRemoveGuest,
                        icon: const Icon(Icons.close, size: 20),
                      ),
                    ],
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }

  String? _badgeText() {
    if (row.isLocked) {
      return OperationsStrings.inactiveBadge(arabic);
    }
    if (row.isGuest) {
      final teamName =
          row.originTeamDisplayName(arabic: arabic) ??
          OperationsStrings.noTeam(arabic);
      return OperationsStrings.fromTeamBadge(arabic, teamName);
    }
    return null;
  }
}
</file>

<file path="lib/features/operations/presentation/widgets/cross_team_search_sheet.dart">
import 'package:material_ui/material_ui.dart';
import 'package:radar_labor/core/constants/operations_constants.dart';
import 'package:radar_labor/core/l10n/operations_strings.dart';
import 'package:radar_labor/core/ui/app_tokens.dart';
import 'package:radar_labor/features/operations/domain/site_attendance_store.dart';

/// Modal bottom sheet to search and add a guest worker from another team (PRD §8.6).
class CrossTeamSearchSheet extends StatefulWidget {
  const CrossTeamSearchSheet({
    required this.arabic,
    required this.onSearch,
    required this.onWorkerSelected,
    super.key,
  });

  final bool arabic;
  final Future<List<CrossTeamWorkerOption>> Function(String query) onSearch;
  final ValueChanged<CrossTeamWorkerOption> onWorkerSelected;

  static Future<void> show({
    required BuildContext context,
    required bool arabic,
    required Future<List<CrossTeamWorkerOption>> Function(String query)
    onSearch,
    required ValueChanged<CrossTeamWorkerOption> onWorkerSelected,
  }) {
    return showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      useSafeArea: true,
      builder: (_) => CrossTeamSearchSheet(
        arabic: arabic,
        onSearch: onSearch,
        onWorkerSelected: onWorkerSelected,
      ),
    );
  }

  @override
  State<CrossTeamSearchSheet> createState() => _CrossTeamSearchSheetState();
}

class _CrossTeamSearchSheetState extends State<CrossTeamSearchSheet> {
  final TextEditingController _controller = TextEditingController();
  List<CrossTeamWorkerOption> _results = const <CrossTeamWorkerOption>[];
  bool _loading = false;

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  Future<void> _handleQueryChanged(String value) async {
    final trimmed = value.trim();
    if (trimmed.length < OperationsConstants.crossTeamSearchMinChars) {
      setState(() {
        _results = const <CrossTeamWorkerOption>[];
        _loading = false;
      });
      return;
    }
    setState(() => _loading = true);
    final items = await widget.onSearch(trimmed);
    if (!mounted || _controller.text.trim() != trimmed) return;
    setState(() {
      _results = items;
      _loading = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    final ar = widget.arabic;
    final query = _controller.text.trim();
    final hasMinChars =
        query.length >= OperationsConstants.crossTeamSearchMinChars;

    return Padding(
      padding: EdgeInsets.only(
        left: AppTokens.space16,
        right: AppTokens.space16,
        top: AppTokens.space16,
        bottom: MediaQuery.viewInsetsOf(context).bottom + AppTokens.space16,
      ),
      child: SizedBox(
        height: 420,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  OperationsStrings.addFromAnotherTeam(ar),
                  style: Theme.of(context).textTheme.titleMedium
                      ?.copyWith(fontWeight: FontWeight.w700),
                ),
                IconButton(
                  onPressed: () => Navigator.of(context).pop(),
                  icon: const Icon(Icons.close),
                ),
              ],
            ),
            const SizedBox(height: AppTokens.space8),
            TextField(
              controller: _controller,
              autofocus: true,
              decoration: InputDecoration(
                hintText: OperationsStrings.crossTeamSearchHint(ar),
                prefixIcon: const Icon(Icons.search),
              ),
              onChanged: _handleQueryChanged,
            ),
            const SizedBox(height: AppTokens.space12),
            Expanded(
              child: !hasMinChars
                  ? Center(
                      child: Text(
                        OperationsStrings.crossTeamSearchHint(ar),
                        style: Theme.of(context).textTheme.bodyMedium,
                        textAlign: TextAlign.center,
                      ),
                    )
                  : _loading
                  ? const Center(child: CircularProgressIndicator())
                  : _results.isEmpty
                  ? Center(
                      child: Text(
                        OperationsStrings.noSearchResults(ar),
                        style: Theme.of(context).textTheme.bodyMedium,
                      ),
                    )
                  : ListView.builder(
                      itemCount: _results.length,
                      itemBuilder: (context, index) {
                        final item = _results[index];
                        final teamName =
                            item.teamDisplayName(arabic: ar) ??
                            OperationsStrings.noTeam(ar);
                        final badge = OperationsStrings.fromTeamBadge(
                          ar,
                          teamName,
                        );
                        return ConstrainedBox(
                          constraints: const BoxConstraints(
                            minHeight: AppTokens.minRowHeight,
                          ),
                          child: ListTile(
                            title: Text(item.worker.displayName(arabic: ar)),
                            subtitle: Text('${item.worker.code} • $badge'),
                            trailing: const Icon(Icons.person_add_alt_1),
                            onTap: () {
                              widget.onWorkerSelected(item);
