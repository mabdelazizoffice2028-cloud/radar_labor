  "fixed_sql": [
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "employees",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"employees\" (\"employee_uid\" TEXT NOT NULL, \"employee_code\" TEXT NOT NULL, \"full_name_ar\" TEXT NOT NULL, \"full_name_en\" TEXT NULL, \"category\" TEXT NOT NULL, \"supplier\" TEXT NULL, \"current_team_id\" TEXT NULL, \"housing_id\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"row_version\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"employee_uid\"));"
        }
      ]
    },
    {
      "name": "teams",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"teams\" (\"team_id\" TEXT NOT NULL, \"name_ar\" TEXT NOT NULL, \"name_en\" TEXT NULL, \"supervisor_user_id\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"team_id\"));"
        }
      ]
    },
    {
      "name": "housings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"housings\" (\"housing_id\" TEXT NOT NULL, \"name_ar\" TEXT NOT NULL, \"name_en\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"housing_id\"));"
        }
      ]
    },
    {
      "name": "employment_periods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"employment_periods\" (\"period_id\" TEXT NOT NULL, \"employee_uid\" TEXT NOT NULL REFERENCES employees (employee_uid) ON DELETE CASCADE, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, PRIMARY KEY (\"period_id\"));"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"event_id\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"device_seq\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"action\" TEXT NOT NULL, \"business_date\" TEXT NOT NULL, \"employee_uid\" TEXT NULL, \"team_id\" TEXT NULL, \"housing_id\" TEXT NULL, \"user_id\" TEXT NULL, \"payload\" TEXT NOT NULL DEFAULT '{}', \"device_time\" INTEGER NOT NULL, \"received_at\" INTEGER NULL, \"server_seq\" INTEGER NULL, \"late\" INTEGER NOT NULL DEFAULT 0 CHECK (\"late\" IN (0, 1)), \"event_schema_version\" INTEGER NOT NULL DEFAULT 1, \"sync_status\" TEXT NOT NULL DEFAULT 'pending', \"reject_reason\" TEXT NULL, PRIMARY KEY (\"event_id\"));"
        }
      ]
    },
